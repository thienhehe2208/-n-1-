@model bài_tập_1.Models.NhaXuatBan

@{
    ViewData["Title"] = "Chỉnh sửa nhà xuất bản";
    var initials = string.Join("", (Model.TenNXB ?? "NXB")
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(word => char.ToUpperInvariant(word[0])));
}

<main class="publisher-edit-page">
    <nav class="publisher-edit-breadcrumb" aria-label="Điều hướng">
        <a asp-action="Index"><i class="bi bi-buildings"></i> Nhà xuất bản</a>
        <i class="bi bi-chevron-right"></i>
        <a asp-action="Details" asp-route-id="@Model.MaNXB">@Model.TenNXB</a>
        <i class="bi bi-chevron-right"></i><span>Chỉnh sửa</span>
    </nav>

    <header class="publisher-edit-hero">
        <span class="publisher-edit-hero-icon"><i class="bi bi-building-gear"></i></span>
        <div><small>HỒ SƠ ĐỐI TÁC · NXB-@Model.MaNXB.ToString("D4")</small><h1>Chỉnh sửa nhà xuất bản</h1><p>Cập nhật thông tin nhận diện, địa chỉ và các kênh liên hệ của đối tác xuất bản.</p></div>
        <a asp-action="Details" asp-route-id="@Model.MaNXB"><i class="bi bi-eye"></i> Xem hồ sơ</a>
    </header>

    <form asp-action="Edit" asp-route-id="@Model.MaNXB" method="post" id="publisherEditForm" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="MaNXB" />
        <div asp-validation-summary="ModelOnly" class="publisher-edit-alert"></div>

        <div class="publisher-edit-layout">
            <section class="publisher-edit-card">
                <header><span><i class="bi bi-building"></i></span><div><h2>Thông tin nhà xuất bản</h2><p>Các trường có dấu <b>*</b> là thông tin bắt buộc.</p></div></header>
                <div class="publisher-edit-fields">
                    <div class="publisher-edit-field wide">
                        <div class="publisher-edit-label"><label asp-for="TenNXB">Tên nhà xuất bản <b>*</b></label><small><span data-count-for="TenNXB">0</span>/150</small></div>
                        <div class="publisher-edit-control"><i class="bi bi-buildings"></i><input asp-for="TenNXB" maxlength="150" autocomplete="organization" placeholder="Nhập tên nhà xuất bản" data-preview-name /></div>
                        <span asp-validation-for="TenNXB"></span>
                    </div>
                    <div class="publisher-edit-field wide">
                        <div class="publisher-edit-label"><label asp-for="DiaChi">Địa chỉ trụ sở</label><small><span data-count-for="DiaChi">0</span>/250</small></div>
                        <div class="publisher-edit-control"><i class="bi bi-geo-alt"></i><input asp-for="DiaChi" maxlength="250" autocomplete="street-address" placeholder="Nhập địa chỉ trụ sở" data-preview-address /></div>
                        <span asp-validation-for="DiaChi"></span>
                    </div>
                    <div class="publisher-edit-field">
                        <label asp-for="SoDienThoai">Số điện thoại</label>
                        <div class="publisher-edit-control"><i class="bi bi-telephone"></i><input asp-for="SoDienThoai" maxlength="20" type="tel" autocomplete="tel" inputmode="tel" placeholder="Ví dụ: 024 1234 5678" data-preview-phone /></div>
                        <span asp-validation-for="SoDienThoai"></span>
                    </div>
                    <div class="publisher-edit-field">
                        <label asp-for="Email">Địa chỉ email</label>
                        <div class="publisher-edit-control"><i class="bi bi-envelope"></i><input asp-for="Email" maxlength="100" type="email" autocomplete="email" placeholder="contact@nxb.vn" data-preview-email /></div>
                        <span asp-validation-for="Email"></span>
                    </div>
                </div>
                <div class="publisher-edit-note"><i class="bi bi-info-circle-fill"></i><span>Thông tin sau khi lưu sẽ được hiển thị tại trang chi tiết nhà xuất bản và các khu vực liên quan.</span></div>
            </section>

            <aside class="publisher-edit-sidebar">
                <section class="publisher-edit-preview">
                    <span class="publisher-edit-preview-label"><i class="bi bi-stars"></i> Xem trước hồ sơ</span>
                    <div class="publisher-edit-avatar" data-preview-avatar>@initials</div>
                    <h2 data-preview-name-text>@Model.TenNXB</h2>
                    <span class="publisher-edit-code">Mã đối tác · NXB-@Model.MaNXB.ToString("D4")</span>
                    <dl>
                        <div><dt><i class="bi bi-geo-alt"></i> Địa chỉ</dt><dd data-preview-address-text>@(string.IsNullOrWhiteSpace(Model.DiaChi) ? "Chưa cập nhật" : Model.DiaChi)</dd></div>
                        <div><dt><i class="bi bi-envelope"></i> Email</dt><dd data-preview-email-text>@(string.IsNullOrWhiteSpace(Model.Email) ? "Chưa cập nhật" : Model.Email)</dd></div>
                        <div><dt><i class="bi bi-telephone"></i> Điện thoại</dt><dd data-preview-phone-text>@(string.IsNullOrWhiteSpace(Model.SoDienThoai) ? "Chưa cập nhật" : Model.SoDienThoai)</dd></div>
                    </dl>
                </section>
                <section class="publisher-edit-guide"><span><i class="bi bi-shield-check"></i></span><div><h2>Dữ liệu đáng tin cậy</h2><p>Kiểm tra kỹ email và số điện thoại để độc giả có thể liên hệ chính xác.</p></div></section>
            </aside>
        </div>

        <footer class="publisher-edit-actions">
            <a asp-action="Details" asp-route-id="@Model.MaNXB"><i class="bi bi-x-lg"></i> Hủy thay đổi</a>
            <button type="reset" class="publisher-edit-reset"><i class="bi bi-arrow-counterclockwise"></i> Khôi phục</button>
            <span id="publisherEditState"><i class="bi bi-check-circle"></i> Chưa có thay đổi</span>
            <button type="submit" class="publisher-edit-save"><i class="bi bi-floppy"></i> Lưu thay đổi</button>
        </footer>
    </form>
</main>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        (() => {
            const form = document.getElementById('publisherEditForm');
            if (!form) return;
            const fields = [...form.querySelectorAll('input:not([type="hidden"])')];
            const initial = new FormData(form);
            const state = document.getElementById('publisherEditState');
            let submitted = false;

            const valueOrFallback = (input, fallback = 'Chưa cập nhật') => input.value.trim() || fallback;
            const initials = value => value.trim().split(/\s+/).filter(Boolean).slice(0, 2).map(word => word[0].toUpperCase()).join('') || 'NXB';
            const update = () => {
                const name = form.querySelector('[data-preview-name]');
                const address = form.querySelector('[data-preview-address]');
                const email = form.querySelector('[data-preview-email]');
                const phone = form.querySelector('[data-preview-phone]');
                document.querySelector('[data-preview-name-text]').textContent = valueOrFallback(name, 'Nhà xuất bản');
                document.querySelector('[data-preview-avatar]').textContent = initials(name.value);
                document.querySelector('[data-preview-address-text]').textContent = valueOrFallback(address);
                document.querySelector('[data-preview-email-text]').textContent = valueOrFallback(email);
                document.querySelector('[data-preview-phone-text]').textContent = valueOrFallback(phone);
                form.querySelectorAll('[data-count-for]').forEach(counter => {
                    const input = form.querySelector(`#${counter.dataset.countFor}`);
                    counter.textContent = input?.value.length ?? 0;
                });
                const dirty = fields.some(field => field.value !== (initial.get(field.name)?.toString() ?? ''));
                state.classList.toggle('dirty', dirty);
                state.innerHTML = dirty ? '<i class="bi bi-pencil-circle"></i> Có thay đổi chưa lưu' : '<i class="bi bi-check-circle"></i> Chưa có thay đổi';
                return dirty;
            };

            fields.forEach(field => field.addEventListener('input', update));
            form.addEventListener('reset', () => setTimeout(update));
            form.addEventListener('submit', () => submitted = true);
            window.addEventListener('beforeunload', event => {
                if (!submitted && update()) { event.preventDefault(); event.returnValue = ''; }
            });
            update();
        })();
    </script>
}
