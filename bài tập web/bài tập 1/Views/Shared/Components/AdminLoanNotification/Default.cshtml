@model AdminLoanNotificationViewModel

<div class="dropdown admin-loan-notification">
    <button class="header-notification" type="button" data-bs-toggle="dropdown"
            data-bs-auto-close="outside" aria-expanded="false" title="Thông báo quản trị">
        <i class="bi bi-bell"></i>
        @if (Model.TongPhieuChoNhan + Model.TongThayDoiChuaDoc > 0)
        {
            var tongThongBao = Model.TongPhieuChoNhan + Model.TongThayDoiChuaDoc;
            <span class="admin-loan-notification-count">@(tongThongBao > 99 ? "99+" : tongThongBao)</span>
        }
    </button>
    <div class="dropdown-menu dropdown-menu-end admin-loan-notification-menu">
        <header>
            <div><strong>Yêu cầu mượn online</strong><small>@(Model.TongPhieuChoNhan == 0 ? "Không có yêu cầu chờ duyệt" : $"{Model.TongPhieuChoNhan} yêu cầu cần kiểm tra")</small></div>
            <span><i class="bi bi-journal-check"></i></span>
        </header>
        @if (Model.PhieuMoi.Count == 0)
        {
            <div class="admin-loan-notification-empty"><i class="bi bi-inbox"></i><span>Yêu cầu mới sẽ xuất hiện tại đây.</span></div>
        }
        else
        {
            <div class="admin-loan-notification-items">
                @foreach (var item in Model.PhieuMoi)
                {
                    <a asp-controller="MuonOnline" asp-action="XacNhan" asp-route-ma="@item.MaXacNhan">
                        <span class="admin-loan-notification-icon"><i class="bi bi-key"></i></span>
                        <span><strong>@item.TenDocGia · @item.TenSaches.Count cuốn</strong><small>@string.Join(" • ", item.TenSaches)</small><time>Gửi lúc @item.NgayTao.ToString("HH:mm dd/MM") · Chờ duyệt</time></span>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                }
            </div>
        }
        @if (Model.ThayDoiMoi.Count > 0)
        {
            <header>
                <div><strong>Thay đổi của nhân viên</strong><small>@(Model.TongThayDoiChuaDoc == 0 ? "Đã xem tất cả thay đổi" : $"{Model.TongThayDoiChuaDoc} thay đổi chưa đọc")</small></div>
                <span><i class="bi bi-shield-exclamation"></i></span>
            </header>
            <div class="admin-loan-notification-items">
                @foreach (var item in Model.ThayDoiMoi)
                {
                    <form asp-controller="ThongBaos" asp-action="MoThongBaoAdmin" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.MaThongBao" />
                        <button type="submit" class="admin-change-notification-item">
                            <span class="admin-loan-notification-icon"><i class="bi bi-pencil-square"></i></span>
                            <span><strong>@item.TieuDe</strong><small>@item.NoiDung</small><time>@item.NgayTao.ToString("HH:mm dd/MM") @(!item.DaDoc ? "· Chưa đọc" : "")</time></span>
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </form>
                }
            </div>
        }
        <a asp-controller="ThongBaos" asp-action="Index" asp-route-hopThu="thay-doi" class="admin-loan-notification-all">Xem thông báo thay đổi <i class="bi bi-arrow-right"></i></a>
        <a asp-controller="DatTruocs" asp-action="Index" class="admin-loan-notification-all">Mở trung tâm yêu cầu <i class="bi bi-arrow-right"></i></a>
    </div>
</div>
