@model IEnumerable<bài_tập_1.Models.BanSao>
@using bài_tập_1.Models
@{
    ViewData["Title"] = "Quản lý kho sách";
    var currentStatus = ViewData["TinhTrang"]?.ToString() ?? "";
    var keyword = ViewData["TuKhoa"]?.ToString() ?? "";
}

<div class="inventory-page">
    <section class="inventory-hero">
        <div><span class="inventory-kicker"><i class="bi bi-box-seam"></i> QUẢN LÝ TÀI NGUYÊN</span><h1>Kho sách &amp; bản sao</h1><p>Theo dõi mã vạch, vị trí kệ và tình trạng của từng cuốn sách trong thư viện.</p></div>
        <a asp-action="Create" class="inventory-create"><i class="bi bi-plus-lg"></i> Thêm bản sao</a>
    </section>

    <section class="inventory-stats">
        <article class="inventory-stat stat-total"><i class="bi bi-collection"></i><div><span>Tổng bản sao</span><strong>@ViewData["TongBanSao"]</strong></div></article>
        <article class="inventory-stat stat-ready"><i class="bi bi-check-circle"></i><div><span>Sẵn có</span><strong>@ViewData["SanCo"]</strong></div></article>
        <article class="inventory-stat stat-loan"><i class="bi bi-arrow-left-right"></i><div><span>Đang mượn</span><strong>@ViewData["DangMuon"]</strong></div></article>
        <article class="inventory-stat stat-damaged"><i class="bi bi-tools"></i><div><span>Hư hỏng</span><strong>@ViewData["HuHong"]</strong></div></article>
        <article class="inventory-stat stat-damaged"><i class="bi bi-question-circle"></i><div><span>Bị mất</span><strong>@ViewData["Mat"]</strong></div></article>
        <article class="inventory-stat stat-loan"><i class="bi bi-bookmark-check"></i><div><span>Đang giữ</span><strong>@ViewData["DaGiu"]</strong></div></article>
        <article class="inventory-stat stat-retired"><i class="bi bi-archive"></i><div><span>Thanh lý</span><strong>@ViewData["ThanhLy"]</strong></div></article>
    </section>

    <section class="inventory-panel">
        <div class="inventory-panel-head">
            <div><span>DANH SÁCH KHO</span><h2>Quản lý bản sao</h2><p>Hiển thị <strong>@Model.Count()</strong> bản sao phù hợp</p></div>
            <form asp-action="Index" method="get" class="inventory-search"><input type="hidden" name="tinhTrang" value="@currentStatus" /><i class="bi bi-search"></i><input name="q" value="@keyword" placeholder="Mã vạch, tên sách hoặc vị trí kệ..." /><button type="submit">Tìm kiếm</button></form>
        </div>
        <nav class="inventory-tabs" aria-label="Lọc tình trạng bản sao">
            <a class="@(string.IsNullOrEmpty(currentStatus) ? "active" : "")" asp-action="Index" asp-route-q="@keyword">Tất cả</a>
            <a class="@(currentStatus == "available" ? "active" : "")" asp-action="Index" asp-route-q="@keyword" asp-route-tinhTrang="available">Sẵn có</a>
            <a class="@(currentStatus == "borrowed" ? "active" : "")" asp-action="Index" asp-route-q="@keyword" asp-route-tinhTrang="borrowed">Đang mượn</a>
            <a class="@(currentStatus == "damaged" ? "active" : "")" asp-action="Index" asp-route-q="@keyword" asp-route-tinhTrang="damaged">Hư hỏng</a>
            <a class="@(currentStatus == "lost" ? "active" : "")" asp-action="Index" asp-route-q="@keyword" asp-route-tinhTrang="lost">Bị mất</a>
            <a class="@(currentStatus == "reserved" ? "active" : "")" asp-action="Index" asp-route-q="@keyword" asp-route-tinhTrang="reserved">Đang giữ</a>
            <a class="@(currentStatus == "liquidated" ? "active" : "")" asp-action="Index" asp-route-q="@keyword" asp-route-tinhTrang="liquidated">Thanh lý</a>
        </nav>
        <div class="inventory-table-wrap">
            <table class="inventory-table">
                <thead><tr><th>Bản sao</th><th>Sách</th><th>Mã vạch</th><th>Vị trí kệ</th><th>Tình trạng</th><th class="inventory-actions-title">Thao tác</th></tr></thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var statusClass = item.TinhTrang switch { TinhTrangBanSao.SanCo => "available", TinhTrangBanSao.DangMuon => "borrowed", TinhTrangBanSao.DaGiu => "borrowed", TinhTrangBanSao.HuHong => "damaged", TinhTrangBanSao.Mat => "damaged", _ => "liquidated" };
                        var statusText = item.TinhTrang switch { TinhTrangBanSao.SanCo => "Sẵn có", TinhTrangBanSao.DangMuon => "Đang mượn", TinhTrangBanSao.DaGiu => "Đang giữ", TinhTrangBanSao.HuHong => "Hư hỏng", TinhTrangBanSao.Mat => "Bị mất", _ => "Đã thanh lý" };
                        <tr>
                            <td><span class="inventory-id">BS-@item.MaBanSao.ToString("D5")</span></td>
                            <td><div class="inventory-book"><span><i class="bi bi-book"></i></span><div><strong>@item.Sach?.TenSach</strong><small>Mã sách: #@item.MaSach</small></div></div></td>
                            <td><code>@item.MaVach</code></td>
                            <td><span class="inventory-shelf"><i class="bi bi-geo-alt"></i> @(string.IsNullOrWhiteSpace(item.ViTriKe) ? "Chưa xếp kệ" : item.ViTriKe)</span></td>
                            <td><span class="inventory-status @statusClass"><i></i>@statusText</span></td>
                            <td><div class="inventory-actions"><a asp-action="Details" asp-route-id="@item.MaBanSao" title="Xem chi tiết"><i class="bi bi-eye"></i></a><a asp-action="Edit" asp-route-id="@item.MaBanSao" title="Chỉnh sửa"><i class="bi bi-pencil"></i></a>@if (User.IsInRole("Admin")) {<a class="delete" asp-action="Delete" asp-route-id="@item.MaBanSao" title="Xóa"><i class="bi bi-trash3"></i></a>}</div></td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Model.Any())
            {
                <div class="inventory-empty"><i class="bi bi-inboxes"></i><h3>Không tìm thấy bản sao</h3><p>Hãy thử thay đổi từ khóa hoặc bộ lọc tình trạng.</p><a asp-action="Index">Xóa bộ lọc</a></div>
            }
        </div>
    </section>
</div>

@if (ViewData["Pagination"] is PaginationViewModel pagination)
{
    <partial name="_Pagination" model="pagination" />
}
