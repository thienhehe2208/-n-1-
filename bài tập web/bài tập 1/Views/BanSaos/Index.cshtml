@model IEnumerable<bài_tập_1.Models.BanSao>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Sach)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaVach)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TinhTrang)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ViTriKe)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Sach.TenSach)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MaVach)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TinhTrang)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ViTriKe)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaBanSao">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MaBanSao">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MaBanSao">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
