@model bài_tập_1.Models.ViewModels.LapPhieuMuonViewModel

@{
    ViewData["Title"] = "Lập phiếu mượn";
}

<div class="card shadow-sm">
    <div class="card-body">
        <h2 class="card-title">Lập phiếu mượn</h2>
        <p class="text-muted">
            Nhân viên xử lý và ngày lập phiếu được xác định tự động
            từ tài khoản đang đăng nhập.
        </p>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="MaDocGia" class="form-label"></label>
                <select asp-for="MaDocGia"
                        asp-items="ViewBag.MaDocGia"
                        class="form-select">
                    <option value="">-- Chọn độc giả --</option>
                </select>
                <span asp-validation-for="MaDocGia"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NgayHenTra" class="form-label"></label>
                <input asp-for="NgayHenTra" class="form-control" />
                <span asp-validation-for="NgayHenTra"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Lập phiếu và thêm sách
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                Quay lại
            </a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
