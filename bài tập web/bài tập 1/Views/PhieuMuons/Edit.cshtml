@model bài_tập_1.Models.ViewModels.CapNhatHanTraViewModel

@{
    ViewData["Title"] = "Cập nhật hạn trả";
}

<div class="card shadow-sm">
    <div class="card-body">
        <h2 class="card-title">
            Cập nhật hạn trả phiếu #PM-@(Model.MaPhieuMuon.ToString("D5"))
        </h2>

        <dl class="row">
            <dt class="col-sm-3">Độc giả</dt>
            <dd class="col-sm-9">@Model.HoTenDocGia</dd>

            <dt class="col-sm-3">Ngày mượn</dt>
            <dd class="col-sm-9">@Model.NgayMuon.ToString("dd/MM/yyyy")</dd>
        </dl>

        <form asp-action="Edit"
              asp-route-id="@Model.MaPhieuMuon"
              method="post">
            <input asp-for="MaPhieuMuon" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="NgayHenTra" class="form-label"></label>
                <input asp-for="NgayHenTra" class="form-control" />
                <span asp-validation-for="NgayHenTra"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Lưu hạn trả
            </button>
            <a asp-action="Details"
                   asp-route-id="@Model.MaPhieuMuon"
                   class="btn btn-outline-secondary">
                Hủy
            </a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
