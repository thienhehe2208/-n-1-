@model bài_tập_1.Models.PhieuMuon
@using bài_tập_1.Models
@using bài_tập_1.Services
@using System.Globalization
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Chi tiết phiếu mượn";
    var laPhieuNhap = Model.TrangThai == TrangThaiPhieuMuon.Nhap;
    var daTra = Model.TrangThai == TrangThaiPhieuMuon.DaTra;
    var quaHan = Model.TrangThai == TrangThaiPhieuMuon.QuaHan;
    var dangMuon = Model.TrangThai == TrangThaiPhieuMuon.DangMuon;
    var sachChuaTra = Model.ChiTietPhieuMuons.Count(c => !c.NgayTra.HasValue);
    var sachDaTra = Model.ChiTietPhieuMuons.Count(c => c.NgayTra.HasValue);
    var soPhieuPhat = Model.ChiTietPhieuMuons.Count(c => c.PhieuPhat != null);
    var tongPhiThue = Model.TongPhiThue;
    var tongTienPhat = Model.TongTienPhat;
    var tongThanhToan = Model.TongThanhToan;
    var tongCanThanhToan = Model.TongCanThanhToan;
    var daThanhToan = Model.TrangThaiThanhToan == TrangThaiThanhToan.DaThanhToan;
    var chuaLapDuPhieuPhat = Model.ChiTietPhieuMuons.Any(c =>
        c.NgayTra.HasValue &&
        (c.NgayTra.Value.Date > Model.NgayHenTra.Date ||
         c.TinhTrangKhiTra is TinhTrangKhiTra.HuHong or TinhTrangKhiTra.Mat) &&
        c.PhieuPhat == null);
    var bankId = Configuration["Payment:BankId"] ?? "970422";
    var bankName = Configuration["Payment:BankName"] ?? "MB Bank";
    var accountNumber = Configuration["Payment:AccountNumber"] ?? "6040122082003";
    var accountName = Configuration["Payment:AccountName"] ?? "LUONG THE THIEN";
    var transferContent = $"THANH TOAN PM{Model.MaPhieuMuon:D5}";
    var qrAmount = decimal.Truncate(tongCanThanhToan)
        .ToString(CultureInfo.InvariantCulture);
    var qrUrl = $"https://img.vietqr.io/image/{Uri.EscapeDataString(bankId)}-" +
        $"{Uri.EscapeDataString(accountNumber)}-compact2.png?amount={qrAmount}" +
        $"&addInfo={Uri.EscapeDataString(transferContent)}" +
        $"&accountName={Uri.EscapeDataString(accountName)}";
    var soNgay = (Model.NgayHenTra.Date - DateTime.Today).Days;
    var statusText = laPhieuNhap ? "Phiếu nháp" : daTra ? "Đã hoàn trả" : quaHan ? "Đang quá hạn" : "Đang mượn";
    var statusClass = laPhieuNhap ? "draft" : daTra ? "returned" : quaHan ? "overdue" : "borrowing";
    var statusIcon = laPhieuNhap ? "bi-pencil-square" : daTra ? "bi-check-circle-fill" : quaHan ? "bi-exclamation-octagon-fill" : "bi-book-half";
}

<section class="loan-detail-page">
    <nav class="loan-detail-breadcrumb" aria-label="breadcrumb">
        <a asp-action="Index"><i class="bi bi-arrow-left"></i> Danh sách phiếu mượn</a><i class="bi bi-chevron-right"></i><span>#PM-@(Model.MaPhieuMuon.ToString("D5"))</span>
    </nav>

    <header class="loan-detail-hero @statusClass">
        <div class="loan-detail-identity">
            <span class="loan-detail-document"><i class="bi bi-file-earmark-text"></i></span>
            <div><span>PHIẾU MƯỢN THƯ VIỆN</span><h1>#PM-@(Model.MaPhieuMuon.ToString("D5"))</h1><p>Được lập lúc @Model.NgayMuon.ToString("HH:mm · dd/MM/yyyy")</p></div>
        </div>
        <div class="loan-detail-hero-actions">
            <span class="loan-detail-status @statusClass"><i class="bi @statusIcon"></i>@statusText</span>
            <div>
                @if (!laPhieuNhap && !daTra && sachChuaTra > 0)
                { <a asp-action="TraSach" asp-route-id="@Model.MaPhieuMuon" class="primary"><i class="bi bi-arrow-return-left"></i> Trả cả phiếu (@sachChuaTra cuốn)</a> }
                @if (!daTra && !quaHan)
                { <a asp-controller="ChiTietPhieuMuons" asp-action="Create" asp-route-maPhieuMuon="@Model.MaPhieuMuon" class="primary"><i class="bi bi-plus-lg"></i> Thêm sách</a> }
                @if (laPhieuNhap)
                { <a asp-action="Edit" asp-route-id="@Model.MaPhieuMuon"><i class="bi bi-calendar-event"></i> Đổi hạn trả</a> }
                @if (!laPhieuNhap && !daTra && !quaHan && sachChuaTra > 0)
                {
                    <form asp-action="GiaHan" asp-route-id="@Model.MaPhieuMuon" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit"><i class="bi bi-calendar-plus"></i> Gia hạn (@Model.SoLanGiaHan/@LibraryRules.SoLanGiaHanToiDa)</button>
                    </form>
                }
            </div>
        </div>
    </header>

    <div class="loan-detail-summary">
        <article><span class="blue"><i class="bi bi-bookshelf"></i></span><div><small>TỔNG SỐ SÁCH</small><strong>@Model.TongSoSach</strong></div></article>
        <article><span class="amber"><i class="bi bi-book"></i></span><div><small>ĐANG GIỮ</small><strong>@sachChuaTra</strong></div></article>
        <article><span class="green"><i class="bi bi-check2-circle"></i></span><div><small>ĐÃ TRẢ</small><strong>@sachDaTra</strong></div></article>
        <article><span class="red"><i class="bi bi-receipt-cutoff"></i></span><div><small>PHIẾU PHẠT</small><strong>@soPhieuPhat</strong></div></article>
    </div>

    <div class="loan-detail-layout">
        <main class="loan-detail-main">
            <article id="loan-books" class="loan-detail-panel loan-detail-books-panel">
                <div class="loan-detail-panel-heading"><div><span>DANH MỤC TÀI LIỆU</span><h2>Sách trong phiếu mượn</h2><p>Các sách thuộc cùng một phiếu phải được tiếp nhận trả đồng thời, không xử lý riêng từng cuốn.</p></div>@if(!daTra&&!quaHan){<a asp-controller="ChiTietPhieuMuons" asp-action="Create" asp-route-maPhieuMuon="@Model.MaPhieuMuon"><i class="bi bi-plus"></i> Thêm bản sao</a>}</div>
                @if (Model.ChiTietPhieuMuons.Count == 0)
                {
                    <div class="loan-detail-empty"><span><i class="bi bi-journal-plus"></i></span><h3>Phiếu chưa có sách</h3><p>Thêm bản sao để hoàn tất phiếu mượn này.</p>@if(!daTra&&!quaHan){<a asp-controller="ChiTietPhieuMuons" asp-action="Create" asp-route-maPhieuMuon="@Model.MaPhieuMuon">Thêm sách đầu tiên</a>}</div>
                }
                else
                {
                    <div class="loan-detail-book-list">
                    @foreach (var item in Model.ChiTietPhieuMuons)
                    {
                        var returned = item.NgayTra.HasValue;
                        var conditionText = item.TinhTrangKhiTra switch { TinhTrangKhiTra.BinhThuong => "Bình thường", TinhTrangKhiTra.HuHong => "Hư hỏng", TinhTrangKhiTra.Mat => "Bị mất", _ => "Chưa đánh giá" };
                        var conditionClass = item.TinhTrangKhiTra switch { TinhTrangKhiTra.BinhThuong => "normal", TinhTrangKhiTra.HuHong => "damaged", TinhTrangKhiTra.Mat => "lost", _ => "pending" };
                        <section class="loan-detail-book-row @(returned ? "returned" : "active")">
                            <span class="loan-detail-book-cover"><i class="bi bi-book"></i></span>
                            <div class="loan-detail-book-name"><small>BẢN GHI SÁCH CT-@(item.MaChiTiet.ToString("D5"))</small><h3>@item.BanSao.Sach.TenSach</h3><span><i class="bi bi-upc-scan"></i> @item.BanSao.MaVach</span></div>
                            <div class="loan-detail-book-fee"><small>PHÍ THUÊ</small><strong>@item.PhiThue.ToString("N0") ₫</strong></div>
                            <div class="loan-detail-book-state"><small>TRẠNG THÁI</small><span class="@(returned ? "returned" : "borrowing")"><i></i>@(returned ? "Đã hoàn trả" : "Đang mượn")</span></div>
                            <div class="loan-detail-book-return"><small>NGÀY TRẢ THỰC TẾ</small><strong>@(item.NgayTra?.ToString("HH:mm · dd/MM/yyyy") ?? "Chưa trả sách")</strong><span class="condition @conditionClass">@conditionText</span></div>
                            <div class="loan-detail-book-actions">
                                <a asp-controller="ChiTietPhieuMuons" asp-action="Details" asp-route-id="@item.MaChiTiet" title="Xem chi tiết"><i class="bi bi-eye"></i></a>
                                @if(item.PhieuPhat!=null){<a asp-controller="PhieuPhats" asp-action="Details" asp-route-id="@item.PhieuPhat.MaPhieuPhat" class="fine" title="Xem phiếu phạt"><i class="bi bi-receipt"></i></a>}
                                else if (returned && (item.NgayTra!.Value.Date > Model.NgayHenTra.Date || item.TinhTrangKhiTra is TinhTrangKhiTra.HuHong or TinhTrangKhiTra.Mat))
                                {<a asp-controller="PhieuPhats" asp-action="Create" asp-route-maChiTiet="@item.MaChiTiet" class="fine" title="Lập phiếu phạt"><i class="bi bi-receipt-cutoff"></i></a>}
                            </div>
                        </section>
                    }
                    </div>
                }
            </article>
        </main>

        <aside class="loan-detail-sidebar">
            <article class="loan-detail-panel loan-detail-people">
                <div class="loan-detail-side-title"><span><i class="bi bi-people"></i></span><div><small>THÔNG TIN LIÊN QUAN</small><h2>Độc giả & nhân viên</h2></div></div>
                <div class="loan-detail-person"><span>@(string.IsNullOrWhiteSpace(Model.DocGia.HoTen) ? "DG" : Model.DocGia.HoTen.Trim()[0].ToString().ToUpper())</span><div><small>ĐỘC GIẢ MƯỢN SÁCH</small><strong>@Model.DocGia.HoTen</strong><em>DG-@Model.MaDocGia.ToString("D5")</em></div></div>
                <div class="loan-detail-person staff"><span><i class="bi bi-person-badge"></i></span><div><small>NHÂN VIÊN XỬ LÝ</small><strong>@Model.NhanVien.HoTen</strong><em>NV-@Model.MaNhanVien.ToString("D5")</em></div></div>
            </article>

            <article class="loan-detail-panel loan-detail-timeline-card">
                <div class="loan-detail-side-title"><span><i class="bi bi-calendar-range"></i></span><div><small>THỜI GIAN LƯU THÔNG</small><h2>Lịch trình phiếu mượn</h2></div></div>
                <div class="loan-detail-timeline">
                    <div class="done"><i></i><span><small>Ngày lập phiếu</small><strong>@Model.NgayMuon.ToString("dd/MM/yyyy HH:mm")</strong></span></div>
                    @if(Model.NgayGiaHanGanNhat.HasValue){<div class="done"><i></i><span><small>Gia hạn gần nhất</small><strong>@Model.NgayGiaHanGanNhat.Value.ToString("dd/MM/yyyy HH:mm")</strong></span></div>}
                    <div class="@(quaHan ? "danger" : daTra ? "done" : "current")"><i></i><span><small>Hạn trả dự kiến</small><strong>@Model.NgayHenTra.ToString("dd/MM/yyyy")</strong>@if(dangMuon){<em>@(soNgay >= 0 ? $"Còn {soNgay} ngày" : $"Quá {-soNgay} ngày")</em>}else if(quaHan){<em>Đã quá hạn @(-soNgay) ngày</em>}</span></div>
                </div>
                <div class="loan-detail-extension"><span><i class="bi bi-arrow-repeat"></i></span><div><small>SỐ LẦN GIA HẠN</small><strong>@Model.SoLanGiaHan / @LibraryRules.SoLanGiaHanToiDa lần</strong></div></div>
            </article>

            <article class="loan-detail-panel loan-payment-card @(daThanhToan ? "paid" : "unpaid")">
                <div class="loan-detail-side-title">
                    <span><i class="bi bi-wallet2"></i></span>
                    <div><small>THANH TOÁN</small><h2>Chi phí phiếu mượn</h2></div>
                </div>
                <div class="loan-payment-lines">
                    <div><span>Phí thuê (@Model.TongSoSach cuốn × @LibraryRules.PhiThueMoiCuon.ToString("N0") ₫)</span><strong>@tongPhiThue.ToString("N0") ₫</strong></div>
                    <div><span>Tiền phạt</span><strong>@tongTienPhat.ToString("N0") ₫</strong></div>
                    <div class="total"><span>Tổng chi phí</span><strong>@tongThanhToan.ToString("N0") ₫</strong></div>
                </div>
                <span class="loan-payment-status @(daThanhToan ? "paid" : "unpaid")">
                    <i class="bi @(daThanhToan ? "bi-check-circle-fill" : "bi-hourglass-split")"></i>
                    @(daThanhToan ? $"Đã thanh toán {Model.NgayThanhToan:dd/MM/yyyy HH:mm}" : "Chưa thanh toán")
                </span>
                @if (daThanhToan && Model.GiaoDichThanhToan != null)
                {
                    var giaoDich = Model.GiaoDichThanhToan;
                    var tenPhuongThuc = giaoDich.PhuongThuc switch
                    {
                        PhuongThucThanhToan.TienMat => "Tiền mặt",
                        PhuongThucThanhToan.ChuyenKhoan => "Chuyển khoản",
                        _ => "Chưa xác định"
                    };
                    <div class="loan-payment-audit">
                        <div><span>Người xác nhận</span><strong>@giaoDich.NhanVienXacNhan.HoTen</strong></div>
                        <div><span>Phương thức</span><strong>@tenPhuongThuc</strong></div>
                        @if (!string.IsNullOrWhiteSpace(giaoDich.MaThamChieu))
                        {
                            <div><span>Mã giao dịch</span><strong>@giaoDich.MaThamChieu</strong></div>
                        }
                        @if (giaoDich.DuLieuKhoiTao)
                        {
                            <small><i class="bi bi-info-circle"></i> Giao dịch được chuyển đổi từ dữ liệu thanh toán cũ.</small>
                        }
                    </div>
                }
                @if (!daThanhToan && chuaLapDuPhieuPhat)
                {
                    <p class="loan-payment-warning"><i class="bi bi-exclamation-triangle"></i> Hãy lập đủ phiếu phạt trước khi thu tiền.</p>
                }
                else if (!daThanhToan && daTra)
                {
                    <button type="button" class="loan-payment-button" data-bs-toggle="modal" data-bs-target="#payLoanModal">
                        <i class="bi bi-cash-coin"></i> Xác nhận thanh toán
                    </button>
                }
                else if (!daThanhToan)
                {
                    <p class="loan-payment-note">Thanh toán được mở sau khi độc giả trả toàn bộ sách.</p>
                }
            </article>

            <a asp-action="Index" class="loan-detail-back"><i class="bi bi-list-ul"></i><span><strong>Quay lại danh sách</strong><small>Tiếp tục quản lý phiếu mượn</small></span><i class="bi bi-chevron-right"></i></a>
        </aside>
    </div>
</section>

@if (!daThanhToan && daTra && !chuaLapDuPhieuPhat)
{
    <div class="modal fade" id="payLoanModal" tabindex="-1" aria-labelledby="payLoanTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="payLoanTitle">Xác nhận đã thu tiền</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div class="loan-payment-qr-layout">
                        <div class="loan-payment-qr">
                            <img src="@qrUrl" alt="Mã VietQR thanh toán phiếu PM-@Model.MaPhieuMuon.ToString("D5")" />
                            <small>Quét bằng ứng dụng ngân hàng</small>
                        </div>
                        <div class="loan-payment-transfer">
                            <p>Độc giả cần thanh toán trong lần này <strong>@tongCanThanhToan.ToString("N0") ₫</strong>.</p>
                            <dl>
                                <div><dt>Ngân hàng</dt><dd>@bankName</dd></div>
                                <div><dt>Số tài khoản</dt><dd>@accountNumber</dd></div>
                                <div><dt>Chủ tài khoản</dt><dd>@accountName</dd></div>
                                <div><dt>Nội dung</dt><dd>@transferContent</dd></div>
                            </dl>
                            <ul class="mb-0">
                                <li>Phí thuê sách: @tongPhiThue.ToString("N0") ₫</li>
                                <li>Phiếu phạt chưa đóng: @Model.TongTienPhatChuaDong.ToString("N0") ₫</li>
                            </ul>
                        </div>
                    </div>
                    <p class="loan-payment-manual-note"><i class="bi bi-info-circle"></i> QR hỗ trợ chuyển khoản, không tự kiểm tra giao dịch. Nhân viên cần đối chiếu tiền vào tài khoản trước khi xác nhận.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Kiểm tra lại</button>
                    <form asp-action="ThanhToan" asp-route-id="@Model.MaPhieuMuon" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="MaPhieuMuon" value="@Model.MaPhieuMuon" />
                        <div class="mb-3 text-start">
                            <label class="form-label" for="paymentMethod">Phương thức thanh toán</label>
                            <select class="form-select" id="paymentMethod" name="PhuongThuc" required>
                                <option value="">-- Chọn phương thức --</option>
                                <option value="@((int)PhuongThucThanhToan.TienMat)">Tiền mặt</option>
                                <option value="@((int)PhuongThucThanhToan.ChuyenKhoan)">Chuyển khoản</option>
                            </select>
                        </div>
                        <div class="mb-3 text-start">
                            <label class="form-label" for="paymentReference">Mã giao dịch ngân hàng</label>
                            <input class="form-control" id="paymentReference" name="MaThamChieu" maxlength="100" placeholder="Bắt buộc nếu chọn chuyển khoản" />
                        </div>
                        <div class="mb-3 text-start">
                            <label class="form-label" for="paymentNote">Ghi chú</label>
                            <textarea class="form-control" id="paymentNote" name="GhiChu" maxlength="250" rows="2" placeholder="Thông tin đối soát nếu có"></textarea>
                        </div>
                        <button type="submit" class="btn btn-success"><i class="bi bi-check2-circle"></i> Đã kiểm tra và thu đủ tiền</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
