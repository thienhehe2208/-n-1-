@model bài_tập_1.Models.ViewModels.TraSachViewModel

@{
    ViewData["Title"] = "Tiếp nhận trả sách";
    var homNay = DateTime.Today;
    var soNgayMuon = Math.Max(1, (Model.NgayTra.Date - Model.NgayMuon.Date).Days);
    var soNgayQuaHan = Math.Max(0, (Model.NgayTra.Date - Model.NgayHenTra.Date).Days);
}

<section class="book-return-page">
    <nav class="book-return-breadcrumb" aria-label="Điều hướng">
        <a asp-controller="PhieuMuons" asp-action="Details" asp-route-id="@Model.MaPhieuMuon">
            <i class="bi bi-arrow-left"></i> Phiếu #PM-@Model.MaPhieuMuon.ToString("D5")
        </a>
        <i class="bi bi-chevron-right"></i>
        <span>Tiếp nhận trả sách</span>
    </nav>

    <header class="book-return-hero">
        <div class="book-return-hero__icon"><i class="bi bi-journal-arrow-down"></i></div>
        <div class="book-return-hero__content">
            <span class="book-return-eyebrow">QUẢN LÝ LƯU THÔNG</span>
            <h1>Tiếp nhận trả sách</h1>
            <p>Kiểm tra thông tin, đánh giá tình trạng bản sao và hoàn tất lượt mượn.</p>
        </div>
        <div class="book-return-hero__code">
            <span>Mã lượt mượn</span>
            <strong>#CT-@Model.MaChiTiet.ToString("D5")</strong>
        </div>
    </header>

    <form asp-action="TraSach" asp-route-id="@Model.MaChiTiet" method="post" class="book-return-form">
        <input asp-for="MaChiTiet" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="book-return-validation" role="alert"></div>

        <div class="book-return-layout">
            <main class="book-return-main">
                <section class="book-return-card book-return-book-card">
                    <div class="book-return-book-icon"><i class="bi bi-book"></i></div>
                    <div class="book-return-book-info">
                        <span class="book-return-card-label">SÁCH ĐƯỢC TRẢ</span>
                        <h2>@Model.TenSach</h2>
                        <div class="book-return-book-meta">
                            <span><i class="bi bi-upc-scan"></i> @Model.MaVach</span>
                            <span><i class="bi bi-person"></i> @Model.HoTenDocGia</span>
                        </div>
                    </div>
                    <a asp-action="Details" asp-route-id="@Model.MaChiTiet" class="book-return-detail-link">
                        Xem chi tiết <i class="bi bi-arrow-up-right"></i>
                    </a>
                </section>

                <section class="book-return-card book-return-process-card">
                    <div class="book-return-card-heading">
                        <span class="book-return-heading-icon"><i class="bi bi-clipboard2-check"></i></span>
                        <div><h2>Thông tin tiếp nhận</h2><p>Điền đầy đủ các thông tin trước khi xác nhận trả sách.</p></div>
                    </div>

                    <div class="book-return-field">
                        <label asp-for="NgayTra"><i class="bi bi-calendar-check"></i> Ngày tiếp nhận trả</label>
                        <div class="book-return-input-wrap">
                            <input asp-for="NgayTra" type="date" max="@homNay.ToString("yyyy-MM-dd")" class="book-return-input" />
                            <span>Không được chọn ngày trong tương lai</span>
                        </div>
                        <span asp-validation-for="NgayTra" class="book-return-field-error"></span>
                    </div>

                    <fieldset class="book-return-field">
                        <legend><i class="bi bi-shield-check"></i> Tình trạng sách khi trả</legend>
                        <p class="book-return-field-hint">Lựa chọn chính xác để hệ thống cập nhật trạng thái bản sao.</p>
                        <div class="book-return-condition-grid">
                            <label class="book-return-condition book-return-condition--good">
                                <input asp-for="TinhTrangKhiTra" type="radio" value="@TinhTrangKhiTra.BinhThuong" />
                                <span class="book-return-condition__check"><i class="bi bi-check-lg"></i></span>
                                <span class="book-return-condition__icon"><i class="bi bi-check-circle"></i></span>
                                <strong>Bình thường</strong>
                                <small>Sách nguyên vẹn, có thể tiếp tục cho mượn</small>
                            </label>
                            <label class="book-return-condition book-return-condition--warning">
                                <input asp-for="TinhTrangKhiTra" type="radio" value="@TinhTrangKhiTra.HuHong" />
                                <span class="book-return-condition__check"><i class="bi bi-check-lg"></i></span>
                                <span class="book-return-condition__icon"><i class="bi bi-tools"></i></span>
                                <strong>Hư hỏng</strong>
                                <small>Cần ghi rõ mức độ và lập phiếu phạt</small>
                            </label>
                            <label class="book-return-condition book-return-condition--danger">
                                <input asp-for="TinhTrangKhiTra" type="radio" value="@TinhTrangKhiTra.Mat" />
                                <span class="book-return-condition__check"><i class="bi bi-check-lg"></i></span>
                                <span class="book-return-condition__icon"><i class="bi bi-exclamation-triangle"></i></span>
                                <strong>Bị mất</strong>
                                <small>Đánh dấu mất và chuyển sang lập phiếu phạt</small>
                            </label>
                        </div>
                        <span asp-validation-for="TinhTrangKhiTra" class="book-return-field-error"></span>
                    </fieldset>

                    <div class="book-return-field">
                        <div class="book-return-label-row">
                            <label asp-for="GhiChu"><i class="bi bi-pencil-square"></i> Ghi chú nghiệp vụ</label>
                            <span>Tối đa 250 ký tự</span>
                        </div>
                        <textarea asp-for="GhiChu" rows="4" maxlength="250" class="book-return-textarea"
                                  placeholder="Ví dụ: Sách còn nguyên vẹn, đủ trang; bìa có vết xước nhẹ..."></textarea>
                        <span asp-validation-for="GhiChu" class="book-return-field-error"></span>
                    </div>
                </section>
            </main>

            <aside class="book-return-sidebar">
                <section class="book-return-card book-return-summary-card">
                    <h2><i class="bi bi-clock-history"></i> Thời gian mượn</h2>
                    <div class="book-return-timeline">
                        <div><span class="dot dot--blue"></span><p>Ngày mượn</p><strong>@Model.NgayMuon.ToString("dd/MM/yyyy")</strong></div>
                        <div><span class="dot @(soNgayQuaHan > 0 ? "dot--red" : "dot--green")"></span><p>Hạn trả</p><strong>@Model.NgayHenTra.ToString("dd/MM/yyyy")</strong></div>
                    </div>
                    <div class="book-return-duration">
                        <span>Thời gian lưu hành</span><strong>@soNgayMuon ngày</strong>
                    </div>
                    @if (soNgayQuaHan > 0)
                    {
                        <div class="book-return-alert book-return-alert--danger">
                            <i class="bi bi-exclamation-octagon"></i>
                            <div><strong>Đã quá hạn @soNgayQuaHan ngày</strong><span>Sau khi xác nhận, hệ thống sẽ chuyển sang bước lập phiếu phạt.</span></div>
                        </div>
                    }
                    else
                    {
                        <div class="book-return-alert book-return-alert--success">
                            <i class="bi bi-check-circle"></i>
                            <div><strong>Trả sách đúng hạn</strong><span>Chưa phát sinh phí phạt do trả trễ.</span></div>
                        </div>
                    }
                </section>

                <section class="book-return-card book-return-note-card">
                    <h2><i class="bi bi-info-circle"></i> Lưu ý nghiệp vụ</h2>
                    <ul>
                        <li>Kiểm tra mã vạch trùng với bản sao thực tế.</li>
                        <li>Đánh giá kỹ bìa, gáy và số trang của sách.</li>
                        <li>Sách hư hỏng, bị mất hoặc trả trễ sẽ cần lập phiếu phạt.</li>
                    </ul>
                </section>
            </aside>
        </div>

        <footer class="book-return-actions">
            <a asp-controller="PhieuMuons" asp-action="Details" asp-route-id="@Model.MaPhieuMuon" class="book-return-cancel">
                <i class="bi bi-x-lg"></i> Hủy thao tác
            </a>
            <div class="book-return-submit-note"><i class="bi bi-shield-lock"></i><span>Thao tác sẽ cập nhật trạng thái bản sao</span></div>
            <button type="submit" class="book-return-submit">
                <i class="bi bi-check2-circle"></i> Xác nhận trả sách
            </button>
        </footer>
    </form>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
