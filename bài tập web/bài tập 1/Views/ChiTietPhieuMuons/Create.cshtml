@model bài_tập_1.Models.ViewModels.ThemSachVaoPhieuViewModel

@{
    ViewData["Title"] = "Thêm sách vào phiếu";
}

<div class="card shadow-sm">
    <div class="card-body">
        <h2 class="card-title">Thêm sách vào phiếu mượn</h2>
        <p class="text-muted">
            Danh sách chỉ hiển thị phiếu còn hiệu lực và bản sao đang sẵn có.
        </p>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="MaPhieuMuon" class="form-label"></label>
                <select asp-for="MaPhieuMuon"
                        asp-items="ViewBag.MaPhieuMuon"
                        class="form-select">
                    <option value="">-- Chọn phiếu mượn --</option>
                </select>
                <span asp-validation-for="MaPhieuMuon"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MaBanSao" class="form-label"></label>
                <select asp-for="MaBanSao"
                        asp-items="ViewBag.MaBanSao"
                        class="form-select">
                    <option value="">-- Chọn sách và mã vạch --</option>
                </select>
                <span asp-validation-for="MaBanSao"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="GhiChu" class="form-label"></label>
                <textarea asp-for="GhiChu"
                          class="form-control"
                          rows="3"></textarea>
                <span asp-validation-for="GhiChu"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Thêm sách
            </button>
            <a asp-controller="PhieuMuons"
                   asp-action="Details"
                   asp-route-id="@Model.MaPhieuMuon"
                   class="btn btn-outline-secondary">
                Quay lại phiếu
            </a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
