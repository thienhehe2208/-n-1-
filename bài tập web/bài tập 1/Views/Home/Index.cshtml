@model TrangChuViewModel

@{
    ViewData["Title"] = "Trang chủ";
    var favoriteIds = ViewData["FavoriteIds"] as HashSet<int> ?? new HashSet<int>();
    const string anhMacDinh = "/images/books/dac-nhan-tam.jpg";
}

<div class="home-view">
    <div class="home-content">
        <section class="hero-banner">
            <div class="hero-content">
                <span class="hero-small-title">Chào mừng bạn đến với</span>
                <h1>THƯ VIỆN TRI THỨC</h1>
                <p>Khám phá các đầu sách thuộc nhiều chủ đề và theo dõi hoạt động mượn trả của bạn.</p>
                <a asp-controller="Saches" asp-action="Index" class="hero-button">
                    <i class="bi bi-search"></i> Tìm sách ngay
                </a>
            </div>
            <div class="hero-image">
                <img src="~/images/books/banner.jpg" alt="Không gian thư viện" class="hero-banner-image" />
            </div>
        </section>

        @if (Model.TheLoaiPhoBien.Any())
        {
            <section class="content-card mb-4">
                <div class="section-heading">
                    <div><span class="section-label">Khám phá</span><h2>Thể loại phổ biến</h2></div>
                    <a asp-controller="TheLoais" asp-action="Index">Xem danh mục <i class="bi bi-arrow-right"></i></a>
                </div>
                <div class="row g-3">
                    @foreach (var category in Model.TheLoaiPhoBien)
                    {
                        <div class="col-6 col-lg">
                            <a asp-controller="Saches" asp-action="Index" asp-route-maTheLoai="@category.MaTheLoai"
                               class="text-decoration-none d-block border rounded-3 p-3 h-100">
                                <i class="bi @category.Icon fs-4"></i>
                                <strong class="d-block mt-2">@category.TenTheLoai</strong>
                                <small class="text-muted">@category.SoLuongSach đầu sách</small>
                            </a>
                        </div>
                    }
                </div>
            </section>
        }

        <div class="home-grid">
            <div class="home-left">
                <section class="content-card" id="sach-moi">
                    <div class="section-heading">
                        <div><span class="section-label">Khám phá</span><h2>Sách mới cập nhật</h2></div>
                        <a asp-controller="Saches" asp-action="Moi">Xem tất cả <i class="bi bi-arrow-right"></i></a>
                    </div>

                    @if (!Model.SachMoi.Any())
                    {
                        <div class="empty-message"><i class="bi bi-journal-x"></i><p>Chưa có sách mới.</p></div>
                    }
                    else
                    {
                        <div class="book-grid">
                            @foreach (var sach in Model.SachMoi)
                            {
                                var daYeuThich = favoriteIds.Contains(sach.MaSach);
                                var soBanSanCo = sach.BanSaos.Count(b => b.TinhTrang == TinhTrangBanSao.SanCo);
                                var anhBia = string.IsNullOrWhiteSpace(sach.AnhBia) ? anhMacDinh : sach.AnhBia;
                                <article class="book-card">
                                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("DocGia"))
                                    {
                                        <form asp-controller="YeuThichs" asp-action="Toggle" method="post" class="home-favorite-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="maSach" value="@sach.MaSach" />
                                            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + "#sach-moi")" />
                                            <button type="submit" class="catalog-heart-button @(daYeuThich ? "is-favorite" : "")"
                                                    aria-label="@(daYeuThich ? "Xóa khỏi yêu thích" : "Thêm vào yêu thích")">
                                                <i class="bi @(daYeuThich ? "bi-heart-fill" : "bi-heart")"></i>
                                            </button>
                                        </form>
                                    }
                                    <a asp-controller="Saches" asp-action="Details" asp-route-id="@sach.MaSach" class="book-image-link">
                                        <span class="book-new-label">Mới</span>
                                        <img src="@anhBia" alt="Ảnh bìa @sach.TenSach" class="book-image" loading="lazy"
                                             onerror="this.onerror=null;this.src='@anhMacDinh';" />
                                    </a>
                                    <div class="book-content">
                                        <a asp-controller="Saches" asp-action="Details" asp-route-id="@sach.MaSach" class="book-title">@sach.TenSach</a>
                                        <p class="book-description">@(string.IsNullOrWhiteSpace(sach.MoTa) ? "Chưa có mô tả cho cuốn sách này." : sach.MoTa)</p>
                                        <div class="book-availability-line @(soBanSanCo > 0 ? "is-available" : "is-unavailable")">
                                            <span><i class="bi @(soBanSanCo > 0 ? "bi-check-circle-fill" : "bi-clock-fill")"></i></span>
                                            <div>
                                                <strong>@(soBanSanCo > 0 ? $"Còn {soBanSanCo} bản sẵn có" : "Hiện đang hết sách")</strong>
                                                <small>@(soBanSanCo > 0 ? "Có thể mượn tại quầy" : "Bạn có thể đặt trước")</small>
                                            </div>
                                        </div>
                                        <div class="book-actions">
                                            <a asp-controller="Saches" asp-action="Details" asp-route-id="@sach.MaSach" class="book-detail-button"><i class="bi bi-eye"></i> Xem chi tiết</a>
                                            @if (soBanSanCo == 0)
                                            {
                                                <a asp-controller="DatTruocs" asp-action="Create" asp-route-maSach="@sach.MaSach" class="book-reserve-button"><i class="bi bi-bookmark-check"></i> Đặt trước</a>
                                            }
                                            else
                                            {
                                    <a asp-controller="MuonOnline" asp-action="Create" asp-route-maSach="@sach.MaSach" class="book-counter-button"><i class="bi bi-journal-plus"></i> Mượn online</a>
                                            }
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </section>
            </div>

            <aside class="home-right">
                @if (User.IsInRole("DocGia") && Model.ThongKeCaNhan != null)
                {
                    var thongKe = Model.ThongKeCaNhan;
                    <section class="content-card reader-personal-stats">
                        <div class="personal-stats-heading">
                            <div>
                                <span class="section-label">Hoạt động của bạn</span>
                                <h2>Thống kê cá nhân</h2>
                            </div>
                            <span class="personal-stats-year">@thongKe.Nam</span>
                        </div>
                        <div class="personal-stats-grid">
                            <article class="stat-blue">
                                <i class="bi bi-journals"></i>
                                <strong>@thongKe.SoSachDaMuonTrongNam</strong>
                                <span>Sách đã mượn trong năm</span>
                            </article>
                            <article class="stat-green">
                                <i class="bi bi-book-half"></i>
                                <strong>@thongKe.SoSachDangMuon</strong>
                                <span>Sách đang mượn</span>
                            </article>
                            <article class="stat-purple">
                                <i class="bi bi-check2-circle"></i>
                                <strong>@thongKe.SoSachTraDungHan</strong>
                                <span>Lần trả đúng hạn</span>
                            </article>
                            <article class="stat-pink">
                                <i class="bi bi-heart-fill"></i>
                                <strong>@thongKe.SoSachYeuThich</strong>
                                <span>Sách yêu thích</span>
                            </article>
                        </div>
                        <a asp-controller="Profile" asp-action="LichSuMuon" class="personal-stats-link">
                            Xem hoạt động chi tiết <i class="bi bi-arrow-right"></i>
                        </a>
                    </section>

                    <section class="content-card borrowed-card">
                        <div class="section-heading compact-heading">
                            <div><span class="section-label">Hiện tại</span><h2>Sách đang mượn</h2></div>
                            <a asp-controller="Profile" asp-action="LichSuMuon">Xem tất cả</a>
                        </div>
                        @if (!Model.SachDangMuon.Any())
                        {
                            <div class="empty-message small-empty-message"><i class="bi bi-journal-check"></i><p>Bạn chưa mượn cuốn sách nào.</p></div>
                        }
                        else
                        {
                            <div class="borrowed-list">
                                @foreach (var sach in Model.SachDangMuon)
                                {
                                    var anhBia = string.IsNullOrWhiteSpace(sach.AnhBia) ? anhMacDinh : sach.AnhBia;
                                    <article class="borrowed-item">
                                        <a asp-controller="Saches" asp-action="Details" asp-route-id="@sach.MaSach" class="borrowed-image-link">
                                            <img src="@anhBia" alt="Ảnh bìa @sach.TenSach" loading="lazy"
                                                 onerror="this.onerror=null;this.src='@anhMacDinh';" />
                                        </a>
                                        <div class="borrowed-details">
                                            <a asp-controller="Saches" asp-action="Details" asp-route-id="@sach.MaSach"><strong>@sach.TenSach</strong></a>
                                            <small>Hạn trả: @sach.NgayTra.ToString("dd/MM/yyyy")</small>
                                        </div>
                                        <span class="days-badge @(sach.SoNgayConLai < 0 ? "overdue-badge" : "")">@(sach.SoNgayConLai < 0 ? $"Quá {Math.Abs(sach.SoNgayConLai)} ngày" : sach.SoNgayConLai == 0 ? "Hạn hôm nay" : $"Còn {sach.SoNgayConLai} ngày")</span>
                                    </article>
                                }
                            </div>
                        }
                    </section>
                }

                <section class="content-card library-rules-card">
                    <div class="rules-card-heading">
                        <span><i class="bi bi-shield-check"></i></span>
                        <div><small>Hướng dẫn bạn đọc</small><h2>Nội quy thư viện</h2></div>
                    </div>
                    <ul>
                        <li><i class="bi bi-book"></i><span>Mượn tối đa <strong>5 cuốn</strong> trong <strong>30 ngày</strong>.</span></li>
                        <li><i class="bi bi-arrow-repeat"></i><span>Được gia hạn tối đa <strong>2 lần</strong>, mỗi lần 14 ngày.</span></li>
                        <li><i class="bi bi-clock-history"></i><span>Trả sách đúng hạn và giữ sách nguyên vẹn.</span></li>
                        <li><i class="bi bi-person-check"></i><span>Không chia sẻ thẻ hoặc tài khoản cho người khác.</span></li>
                    </ul>
                    <a asp-controller="Home" asp-action="Terms">Xem nội quy đầy đủ <i class="bi bi-arrow-right"></i></a>
                </section>

                <section class="content-card opening-card">
                    <div class="section-heading compact-heading"><div><span class="section-label">Thời gian</span><h2>Lịch thư viện</h2></div></div>
                    <div class="opening-content"><span class="opening-icon"><i class="bi bi-calendar-week"></i></span><div><strong>Giờ mở cửa</strong><p>Thứ 2 - Thứ 6: 07:30 - 17:00</p><p>Thứ 7: 07:30 - 11:30</p><p>Chủ nhật: Nghỉ</p></div></div>
                </section>
            </aside>
        </div>
    </div>
</div>
