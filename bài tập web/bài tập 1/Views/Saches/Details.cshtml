@model bài_tập_1.Models.Sach

@{
    ViewData["Title"] = Model.TenSach;
    var cover = string.IsNullOrWhiteSpace(Model.AnhBia) ? "/images/books/dac-nhan-tam.jpg" : Model.AnhBia;
    var authors = Model.SachTacGias.Where(x => x.TacGia != null).Select(x => x.TacGia.HoTen).ToList();
    var available = Model.BanSaos.Count(x => x.TinhTrang == TinhTrangBanSao.SanCo);
    var isStaff = User.IsInRole("Admin") || User.IsInRole("NhanVien");
    var staffRole = User.IsInRole("Admin") ? "Quản trị viên" : "Nhân viên thư viện";
}

<section class="reader-book-detail">
    <nav class="reader-book-breadcrumb" aria-label="Đường dẫn">
        <a asp-controller="Home" asp-action="Index">Trang chủ</a><i class="bi bi-chevron-right"></i>
        <a asp-action="Index" asp-route-maTheLoai="@Model.MaTheLoai">@Model.TheLoai.TenTheLoai</a><i class="bi bi-chevron-right"></i>
        <span>@Model.TenSach</span>
    </nav>

    <div class="reader-book-detail-card">
        <div class="reader-book-detail-cover">
            <img src="@cover" alt="Bìa sách @Model.TenSach" />
            <span><i class="bi bi-grid"></i> @Model.TheLoai.TenTheLoai</span>
        </div>
        <div class="reader-book-detail-info">
            <span class="reader-book-detail-kicker">THÔNG TIN ĐẦU SÁCH</span>
            <h1>@Model.TenSach</h1>
            <p class="reader-book-authors"><i class="bi bi-person"></i> @(authors.Any() ? string.Join(", ", authors) : "Tác giả đang cập nhật")</p>

            <div class="reader-book-facts">
                <div><small>Nhà xuất bản</small><strong>@Model.NhaXuatBan.TenNXB</strong></div>
                <div><small>Năm xuất bản</small><strong>@(Model.NamXuatBan?.ToString() ?? "Chưa rõ")</strong></div>
                <div><small>Số trang</small><strong>@(Model.SoTrang?.ToString() ?? "--") trang</strong></div>
                <div><small>Ngôn ngữ</small><strong>@Model.NgonNgu</strong></div>
                <div><small>ISBN</small><strong>@Model.ISBN</strong></div>
            </div>

            <div class="reader-book-stock @(available > 0 ? "available" : "unavailable")">
                <span><i class="bi @(available > 0 ? "bi-check-circle-fill" : "bi-clock-fill")"></i></span>
                <div>
                    <strong>@(available > 0 ? "Sách đang sẵn sàng" : "Tạm thời hết sách")</strong>
                    <small>@(available > 0 ? $"Còn {available} bản – có thể tạo phiếu mượn online" : "Hãy đặt trước để được thông báo khi sách về")</small>
                </div>
            </div>

            <div class="reader-book-description">
                <h2>Giới thiệu sách</h2>
                <p>@(string.IsNullOrWhiteSpace(Model.MoTa) ? "Nội dung giới thiệu đang được cập nhật." : Model.MoTa)</p>
            </div>

            <div class="reader-book-detail-actions">
                @if (available > 0)
                {
                    @if (isStaff)
                    {
                        <button type="button" class="primary staff-borrow-trigger" data-staff-borrow-open><i class="bi bi-qr-code-scan"></i><span>Mượn online</span></button>
                    }
                    else
                    {
                        <a asp-controller="MuonOnline" asp-action="Create" asp-route-maSach="@Model.MaSach" class="primary"><i class="bi bi-qr-code-scan"></i><span>Mượn online</span></a>
                    }
                }
                else
                {
                    <a asp-controller="DatTruocs" asp-action="Create" asp-route-maSach="@Model.MaSach" class="primary">
                        <i class="bi bi-bookmark-check"></i><span>Đặt trước</span>
                    </a>
                }
                <a asp-action="Index" asp-route-maTheLoai="@Model.MaTheLoai" class="secondary">
                    <i class="bi bi-arrow-left"></i><span>Quay lại danh mục</span>
                </a>
            </div>
        </div>
    </div>
</section>

@if (isStaff)
{
    <div class="staff-borrow-modal" data-staff-borrow-modal aria-hidden="true">
        <button type="button" class="staff-borrow-modal__backdrop" data-staff-borrow-close aria-label="Đóng thông báo"></button>
        <section class="staff-borrow-dialog" role="dialog" aria-modal="true" aria-labelledby="staffBorrowTitle" aria-describedby="staffBorrowDescription">
            <button type="button" class="staff-borrow-dialog__close" data-staff-borrow-close aria-label="Đóng"><i class="bi bi-x-lg"></i></button>
            <div class="staff-borrow-dialog__visual"><span><i class="bi @(User.IsInRole("Admin") ? "bi-shield-lock-fill" : "bi-person-badge-fill")"></i></span><i class="bi bi-stars"></i></div>
            <div class="staff-borrow-dialog__role"><i class="bi bi-patch-check-fill"></i> @staffRole</div>
            <h2 id="staffBorrowTitle">Tài khoản quản lý không cần mượn online</h2>
            <p id="staffBorrowDescription">Bạn đang đăng nhập với quyền <strong>@staffRole</strong>. Tính năng mượn online được dành riêng cho độc giả; tài khoản của bạn có thể trực tiếp tiếp nhận và xử lý phiếu mượn tại quầy.</p>
            <div class="staff-borrow-dialog__book"><span><i class="bi bi-book"></i></span><div><small>SÁCH ĐANG XEM</small><strong>@Model.TenSach</strong></div></div>
            <div class="staff-borrow-dialog__hint"><i class="bi bi-lightbulb-fill"></i><span>Để hỗ trợ độc giả, hãy vào <strong>Quản lý phiếu mượn</strong> và tạo hoặc xử lý phiếu tại quầy.</span></div>
            <div class="staff-borrow-dialog__actions"><button type="button" data-staff-borrow-close><i class="bi bi-check2"></i> Đã hiểu</button><a asp-controller="PhieuMuons" asp-action="Index"><i class="bi bi-arrow-up-right-circle"></i> Quản lý phiếu mượn</a></div>
        </section>
    </div>
}

@section Scripts {
    @if (isStaff)
    {
        <script>
            (() => {
                const modal = document.querySelector('[data-staff-borrow-modal]');
                const trigger = document.querySelector('[data-staff-borrow-open]');
                if (!modal || !trigger) return;
                const close = () => { modal.classList.remove('is-open'); modal.setAttribute('aria-hidden', 'true'); document.body.classList.remove('staff-modal-open'); trigger.focus(); };
                const open = () => { modal.classList.add('is-open'); modal.setAttribute('aria-hidden', 'false'); document.body.classList.add('staff-modal-open'); modal.querySelector('.staff-borrow-dialog__close').focus(); };
                trigger.addEventListener('click', open);
                modal.querySelectorAll('[data-staff-borrow-close]').forEach(button => button.addEventListener('click', close));
                document.addEventListener('keydown', event => { if (event.key === 'Escape' && modal.classList.contains('is-open')) close(); });
            })();
        </script>
    }
}
