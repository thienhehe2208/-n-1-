@model IEnumerable<bài_tập_1.Models.Sach>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input name="q" value="@ViewData["Search"]"
               class="form-control"
               placeholder="Tìm theo tên sách hoặc ISBN" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
    {
        <div class="col-auto">
            <a asp-action="Create" class="btn btn-primary">Thêm sách</a>
        </div>
    }
</form>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TenSach)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ISBN)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GiaSach)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TheLoai)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NhaXuatBan)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NamXuatBan)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SoTrang)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NgonNgu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MoTa)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AnhBia)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.TenSach)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ISBN)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.GiaSach)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TheLoai.TenTheLoai)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NhaXuatBan.TenNXB)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NamXuatBan)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SoTrang)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NgonNgu)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MoTa)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.AnhBia)
                </td>
                <td>
                    <a asp-action="Details"
                           asp-route-id="@item.MaSach"
                           class="btn btn-sm btn-outline-primary">
                        Xem chi tiết
                    </a>
                    <a asp-controller="DatTruocs"
                           asp-action="Create"
                           asp-route-maSach="@item.MaSach"
                           class="btn btn-sm btn-success">
                        <i class="bi bi-bookmark-check"></i>
                        Đặt trước
                    </a>
                    @if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.MaSach" class="btn btn-sm btn-outline-warning">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.MaSach" class="btn btn-sm btn-outline-danger">Xóa</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
