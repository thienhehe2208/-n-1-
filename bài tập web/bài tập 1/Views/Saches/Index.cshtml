@model IEnumerable<bài_tập_1.Models.Sach>

@{
    ViewData["Title"] = "Kho sách";
    var tuKhoa = ViewData["Search"]?.ToString();
    var favoriteIds = ViewData["FavoriteIds"] as HashSet<int> ?? new HashSet<int>();
    var selectedCategory = ViewData["SelectedCategory"] as TheLoai;
    var categories = ViewData["Categories"] as IEnumerable<TheLoai> ?? Enumerable.Empty<TheLoai>();
    var selectedCategoryId = ViewData["MaTheLoai"] as int?;
    var totalResults = (int?)ViewData["TotalResults"] ?? 0;
    var isStaff = User.IsInRole("Admin") || User.IsInRole("NhanVien");
    var staffRole = User.IsInRole("Admin") ? "Quản trị viên" : "Nhân viên thư viện";
}

<section class="catalog-page">
    <div class="catalog-search-hero @(selectedCategory != null ? "is-category" : "")">
        <div class="catalog-search-intro">
            <span class="catalog-search-kicker">
                <i class="bi bi-stars"></i>
                @(selectedCategory == null ? "THƯ VIỆN TRỰC TUYẾN" : "DANH MỤC ĐANG KHÁM PHÁ")
            </span>
            <h1>
                @(selectedCategory == null ? "Tìm cuốn sách" : selectedCategory.TenTheLoai)
                @if (selectedCategory == null)
                {
                    <br /><text>dành cho bạn</text>
                }
            </h1>
            <p>
                @(selectedCategory == null
                ? "Khám phá kho tri thức và tra cứu nhanh theo tên sách hoặc mã ISBN."
                : (string.IsNullOrWhiteSpace(selectedCategory.MoTa)
                    ? "Khám phá những đầu sách nổi bật trong danh mục này."
                    : selectedCategory.MoTa))
            </p>
            <div class="catalog-search-benefits" aria-label="Tiện ích tìm kiếm">
                <span><i class="bi bi-lightning-charge-fill"></i> Tra cứu nhanh</span>
                <span><i class="bi bi-check-circle-fill"></i> Kiểm tra sách có sẵn</span>
            </div>

        </div>

        <form asp-action="Index" method="get" class="catalog-search-form" role="search">
            @if (selectedCategoryId.HasValue)
            {
                <input type="hidden" name="maTheLoai" value="@selectedCategoryId.Value" />
            }
            <label for="catalog-search-input">Bạn muốn tìm sách gì?</label>
            <div class="catalog-search-field">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input id="catalog-search-input"
                       type="search"
                       name="q"
                       value="@tuKhoa"
                       placeholder="@(selectedCategory == null ? "Tên sách hoặc mã ISBN..." : $"Tìm trong {selectedCategory.TenTheLoai}...")"
                       autocomplete="off" />
                @if (!string.IsNullOrWhiteSpace(tuKhoa))
                {
                    <a asp-action="Index" asp-route-maTheLoai="@selectedCategoryId" class="catalog-search-clear" aria-label="Xóa từ khóa" title="Xóa từ khóa">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
            <button type="submit" class="catalog-search-submit">
                <i class="bi bi-search"></i>
                <span>Tìm kiếm sách</span>
            </button>
            <small>Ví dụ: Đắc nhân tâm, 978604...</small>
        </form>
    </div>

    <nav class="catalog-category-switcher" aria-label="Chọn danh mục sách">
        <a asp-action="Index" class="@(selectedCategory == null ? "active" : "")">
            <i class="bi bi-collection"></i><span>Tất cả sách</span>
        </a>
        @foreach (var category in categories)
        {
            <a asp-action="Index"
               asp-route-maTheLoai="@category.MaTheLoai"
               class="@(selectedCategoryId == category.MaTheLoai ? "active" : "")">
                <span>@category.TenTheLoai</span>
                <small>@category.DanhSachSach.Count</small>
            </a>
        }
    </nav>

    <div class="catalog-result-toolbar">
        <div class="catalog-result-title">
            <span class="catalog-result-icon"><i class="bi bi-grid"></i></span>
            <div>
                <h2>
                    @(!string.IsNullOrWhiteSpace(tuKhoa)
                    ? "Kết quả tìm kiếm"
                    : selectedCategory == null ? "Kho sách thư viện" : $"Sách {selectedCategory.TenTheLoai}")
                </h2>
                <p class="book-search-summary" aria-live="polite">
                    @if (!string.IsNullOrWhiteSpace(tuKhoa))
                    {
                        <span>Tìm thấy <strong>@totalResults</strong> cuốn sách cho “@tuKhoa”</span>
                    }
                    else
                    {
                        <span>Hiện có <strong>@totalResults</strong> cuốn sách để bạn khám phá</span>
                    }
                </p>
            </div>
        </div>
        @if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
        {
            <a asp-action="Create" class="book-add-button">
                <i class="bi bi-plus-lg"></i>
                <span>Thêm sách mới</span>
            </a>
        }
    </div>

    @if (Model.Any())
    {
        <div class="catalog-grid">
            @foreach (var item in Model)
            {
                var soBanSanCo = item.BanSaos.Count(b => b.TinhTrang == TinhTrangBanSao.SanCo);
                var coTheMuon = soBanSanCo > 0;
                var daYeuThich = favoriteIds.Contains(item.MaSach);

                <article class="catalog-card">
                    @if (!User.IsInRole("Admin") && !User.IsInRole("NhanVien"))
                    {
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-controller="YeuThichs" asp-action="Toggle" method="post" class="catalog-favorite-form">
                                <input type="hidden" name="maSach" value="@item.MaSach" />
                                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                <button type="submit" class="catalog-heart-button @(daYeuThich ? "is-favorite" : "")" aria-label="@(daYeuThich ? "Xóa khỏi yêu thích" : "Thêm vào yêu thích")">
                                    <i class="bi @(daYeuThich ? "bi-heart-fill" : "bi-heart")"></i>
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="catalog-favorite-form"><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)" class="catalog-heart-button" aria-label="Đăng nhập để yêu thích"><i class="bi bi-heart"></i></a></div>
                        }
                    }
                    <a asp-action="Details"
                       asp-route-id="@item.MaSach"
                       class="catalog-cover"
                       aria-label="Xem chi tiết @item.TenSach">
                        <span class="catalog-cover-placeholder" aria-hidden="true">
                            <i class="bi bi-book"></i>
                        </span>
                        @if (!string.IsNullOrWhiteSpace(item.AnhBia))
                        {
                            <img src="@item.AnhBia"
                                 alt="Bìa sách @item.TenSach"
                                 loading="lazy"
                                 onerror="this.style.display='none'" />
                        }
                        <span class="catalog-category">@item.TheLoai.TenTheLoai</span>
                        <span class="catalog-availability @(coTheMuon ? "is-available" : "is-unavailable")">
                            <i class="bi @(coTheMuon ? "bi-check-circle-fill" : "bi-clock-fill")"></i>
                            @(coTheMuon ? $"Còn {soBanSanCo} bản" : "Tạm hết")
                        </span>
                    </a>

                    <div class="catalog-card-body">
                        <div class="catalog-meta">
                            <span><i class="bi bi-calendar3"></i> @(item.NamXuatBan?.ToString() ?? "Chưa rõ")</span>
                            <span><i class="bi bi-file-earmark-text"></i> @(item.SoTrang?.ToString() ?? "--") trang</span>
                        </div>

                        <h2>
                            <a asp-action="Details" asp-route-id="@item.MaSach">@item.TenSach</a>
                        </h2>

                        <p class="catalog-publisher">
                            <i class="bi bi-building"></i>
                            <span>@item.NhaXuatBan.TenNXB</span>
                        </p>

                        <p class="catalog-description">
                            @(string.IsNullOrWhiteSpace(item.MoTa)
                                ? "Thông tin mô tả đang được cập nhật."
                                : item.MoTa)
                        </p>

                        <div class="catalog-card-footer catalog-library-footer">
                            <div class="catalog-actions">
                                <a asp-action="Details"
                                   asp-route-id="@item.MaSach"
                                   class="catalog-detail-button"
                                   aria-label="Xem chi tiết @item.TenSach"
                                   title="Xem chi tiết">
                                    <i class="bi bi-eye"></i>
                                    <span>Chi tiết</span>
                                </a>
                                @if (!coTheMuon)
                                {
                                    <a asp-controller="DatTruocs"
                                       asp-action="Create"
                                       asp-route-maSach="@item.MaSach"
                                       class="catalog-reserve-button">
                                        <i class="bi bi-bookmark-plus"></i>
                                        <span>Đặt trước</span>
                                    </a>
                                }
                                else
                                {
                                    @if (isStaff)
                                    {
                                        <button type="button" class="catalog-counter-button" data-staff-borrow-open data-book-title="@item.TenSach"><i class="bi bi-qr-code-scan"></i><span>Mượn online</span></button>
                                    }
                                    else
                                    {
                                        <a asp-controller="MuonOnline" asp-action="Create" asp-route-maSach="@item.MaSach" class="catalog-counter-button"><i class="bi bi-qr-code-scan"></i><span>Mượn online</span></a>
                                    }
                                }
                            </div>
                        </div>

                        @if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
                        {
                            <div class="catalog-admin-actions">
                                <a asp-action="Edit" asp-route-id="@item.MaSach">
                                    <i class="bi bi-pencil-square"></i> Chỉnh sửa
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.MaSach" class="is-danger">
                                    <i class="bi bi-trash3"></i> Xóa
                                </a>
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="catalog-empty">
            <span><i class="bi bi-search"></i></span>
            <h2>Chưa tìm thấy sách phù hợp</h2>
            <p>
                @(selectedCategory == null
                    ? "Thử kiểm tra lại từ khóa hoặc tìm bằng mã ISBN khác."
                    : "Danh mục này hiện chưa có sách phù hợp.")
            </p>
            <a asp-action="Index">Xem tất cả sách</a>
        </div>
    }
</section>

@if (ViewData["Pagination"] is PaginationViewModel pagination)
{
    <partial name="_Pagination" model="pagination" />
}

@if (isStaff)
{
    <div class="staff-borrow-modal" data-staff-borrow-modal aria-hidden="true">
        <button type="button" class="staff-borrow-modal__backdrop" data-staff-borrow-close aria-label="Đóng thông báo"></button>
        <section class="staff-borrow-dialog" role="dialog" aria-modal="true" aria-labelledby="staffBorrowTitle" aria-describedby="staffBorrowDescription">
            <button type="button" class="staff-borrow-dialog__close" data-staff-borrow-close aria-label="Đóng"><i class="bi bi-x-lg"></i></button>
            <div class="staff-borrow-dialog__visual"><span><i class="bi @(User.IsInRole("Admin") ? "bi-shield-lock-fill" : "bi-person-badge-fill")"></i></span><i class="bi bi-stars"></i></div>
            <div class="staff-borrow-dialog__role"><i class="bi bi-patch-check-fill"></i> @staffRole</div>
            <h2 id="staffBorrowTitle">Tài khoản quản lý không cần mượn online</h2>
            <p id="staffBorrowDescription">Bạn đang đăng nhập với quyền <strong>@staffRole</strong>. Tính năng mượn online được dành riêng cho độc giả; tài khoản của bạn có thể trực tiếp tiếp nhận và xử lý phiếu mượn tại quầy.</p>
            <div class="staff-borrow-dialog__book"><span><i class="bi bi-book"></i></span><div><small>SÁCH ĐANG CHỌN</small><strong data-staff-book-title>Thông tin sách</strong></div></div>
            <div class="staff-borrow-dialog__hint"><i class="bi bi-lightbulb-fill"></i><span>Để hỗ trợ độc giả, hãy vào <strong>Quản lý phiếu mượn</strong> và tạo hoặc xử lý phiếu tại quầy.</span></div>
            <div class="staff-borrow-dialog__actions"><button type="button" data-staff-borrow-close><i class="bi bi-check2"></i> Đã hiểu</button><a asp-controller="PhieuMuons" asp-action="Index"><i class="bi bi-arrow-up-right-circle"></i> Quản lý phiếu mượn</a></div>
        </section>
    </div>
}

@section Scripts {
    @if (isStaff)
    {
        <script>
            (() => {
                const modal = document.querySelector('[data-staff-borrow-modal]');
                const triggers = document.querySelectorAll('[data-staff-borrow-open]');
                const title = modal?.querySelector('[data-staff-book-title]');
                let activeTrigger = null;
                if (!modal || !triggers.length) return;
                const close = () => { modal.classList.remove('is-open'); modal.setAttribute('aria-hidden', 'true'); document.body.classList.remove('staff-modal-open'); activeTrigger?.focus(); };
                const open = trigger => { activeTrigger = trigger; title.textContent = trigger.dataset.bookTitle || 'Thông tin sách'; modal.classList.add('is-open'); modal.setAttribute('aria-hidden', 'false'); document.body.classList.add('staff-modal-open'); modal.querySelector('.staff-borrow-dialog__close').focus(); };
                triggers.forEach(trigger => trigger.addEventListener('click', () => open(trigger)));
                modal.querySelectorAll('[data-staff-borrow-close]').forEach(button => button.addEventListener('click', close));
                document.addEventListener('keydown', event => { if (event.key === 'Escape' && modal.classList.contains('is-open')) close(); });
            })();
        </script>
    }
}
