@model bài_tập_1.Models.DocGia

@{
    ViewData["Title"] = "Thông tin cá nhân";
    var ten = string.IsNullOrWhiteSpace(Model.HoTen) ? "Người dùng" : Model.HoTen.Trim();
    var parts = ten.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = parts.Length > 1
        ? $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
        : ten[..Math.Min(2, ten.Length)].ToUpperInvariant();
    var dangHoatDong = Model.TrangThai == TrangThaiDocGia.HoatDong;
}

<section class="profile-page">
    <header class="profile-cover">
        <div class="profile-cover-pattern" aria-hidden="true"></div>
        <div class="profile-identity">
            <div class="profile-avatar" aria-label="Ảnh đại diện">@initials</div>
            <div>
                <span class="profile-kicker">HỒ SƠ ĐỘC GIẢ</span>
                <h1>@ten</h1>
                <p><i class="bi bi-envelope"></i> @Model.Email</p>
            </div>
        </div>
        <div class="profile-header-actions">
            <span class="profile-status @(dangHoatDong ? "is-active" : "is-locked")">
                <i class="bi @(dangHoatDong ? "bi-check-circle-fill" : "bi-lock-fill")"></i>
                @(dangHoatDong ? "Tài khoản hoạt động" : "Tài khoản bị khóa")
            </span>
            <a asp-action="Edit" class="profile-edit-button">
                <i class="bi bi-pencil-square"></i> Chỉnh sửa hồ sơ
            </a>
        </div>
    </header>

    <div class="profile-layout">
        <div class="profile-main-column">
            <article class="profile-panel">
                <div class="profile-panel-heading">
                    <span><i class="bi bi-person-vcard"></i></span>
                    <div>
                        <h2>Thông tin cá nhân</h2>
                        <p>Thông tin cơ bản được sử dụng trong hệ thống thư viện.</p>
                    </div>
                </div>
                <div class="profile-info-grid">
                    <div class="profile-field">
                        <span>Họ và tên</span><strong>@ten</strong>
                    </div>
                    <div class="profile-field">
                        <span>Mã độc giả</span><strong>DG-@Model.MaDocGia.ToString("D5")</strong>
                    </div>
                    <div class="profile-field">
                        <span>Ngày sinh</span><strong>@(Model.NgaySinh?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</strong>
                    </div>
                    <div class="profile-field">
                        <span>Giới tính</span><strong>@(string.IsNullOrWhiteSpace(Model.GioiTinh) ? "Chưa cập nhật" : Model.GioiTinh)</strong>
                    </div>
                    <div class="profile-field profile-field-wide">
                        <span>Địa chỉ</span><strong>@(string.IsNullOrWhiteSpace(Model.DiaChi) ? "Chưa cập nhật" : Model.DiaChi)</strong>
                    </div>
                </div>
            </article>

            <article class="profile-panel">
                <div class="profile-panel-heading">
                    <span><i class="bi bi-shield-lock"></i></span>
                    <div>
                        <h2>Tài khoản và bảo mật</h2>
                        <p>Thông tin đăng nhập của bạn được bảo vệ bởi ASP.NET Identity.</p>
                    </div>
                </div>
                <div class="profile-security-list">
                    <div class="profile-security-row">
                        <span class="profile-security-icon"><i class="bi bi-envelope-at"></i></span>
                        <div><small>Email đăng nhập</small><strong>@Model.Email</strong></div>
                        <span class="profile-verified"><i class="bi bi-patch-check-fill"></i> Đã xác minh</span>
                    </div>
                    <div class="profile-security-row">
                        <span class="profile-security-icon"><i class="bi bi-key"></i></span>
                        <div><small>Mật khẩu</small><strong class="profile-password" aria-label="Mật khẩu đã được ẩn">●●●●●●●●●●</strong></div>
                        <a asp-action="ChangePassword" class="profile-change-password"><i class="bi bi-pencil-square"></i> Đổi mật khẩu</a>
                    </div>
                    <div class="profile-security-row">
                        <span class="profile-security-icon"><i class="bi bi-telephone"></i></span>
                        <div><small>Số điện thoại</small><strong>@(string.IsNullOrWhiteSpace(Model.SoDienThoai) ? "Chưa cập nhật" : Model.SoDienThoai)</strong></div>
                    </div>
                </div>
            </article>
        </div>

        <aside class="profile-side-column">
            <article class="profile-membership-card">
                <span class="profile-membership-icon"><i class="bi bi-credit-card-2-front"></i></span>
                <span class="profile-kicker">THẺ THƯ VIỆN</span>
                <h2>@ten</h2>
                <code>DG-@Model.MaDocGia.ToString("D5")</code>
                <div class="profile-membership-dates">
                    <div><small>Ngày đăng ký</small><strong>@Model.NgayDangKy.ToString("dd/MM/yyyy")</strong></div>
                    <div><small>Hết hạn thẻ</small><strong>@Model.NgayHetHanThe.ToString("dd/MM/yyyy")</strong></div>
                </div>
            </article>
            <a asp-action="LichSuMuon" class="profile-history-link">
                <span><i class="bi bi-clock-history"></i></span>
                <div><strong>Lịch sử mượn sách</strong><small>Xem sách đang mượn và đã trả</small></div>
                <i class="bi bi-chevron-right"></i>
            </a>
            <div class="profile-privacy-note">
                <i class="bi bi-shield-check"></i>
                <p><strong>Quyền riêng tư của bạn</strong><span>Mật khẩu không bao giờ được hiển thị hoặc gửi về trình duyệt.</span></p>
            </div>
        </aside>
    </div>
</section>
