@model bài_tập_1.Models.NhanVien

@{
    ViewData["Title"] = "Thông tin cá nhân";
}

<h2>Thông tin cá nhân</h2>

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Họ tên</dt>
            <dd class="col-sm-8">@Model.HoTen</dd>

            <dt class="col-sm-4">Ngày sinh</dt>
            <dd class="col-sm-8">@(Model.NgaySinh?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</dd>

            <dt class="col-sm-4">Giới tính</dt>
            <dd class="col-sm-8">@Model.GioiTinh</dd>

            <dt class="col-sm-4">Địa chỉ</dt>
            <dd class="col-sm-8">@Model.DiaChi</dd>

            <dt class="col-sm-4">Số điện thoại</dt>
            <dd class="col-sm-8">@Model.SoDienThoai</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4">Chức vụ</dt>
            <dd class="col-sm-8">@Model.ChucVu</dd>

            <dt class="col-sm-4">Ngày vào làm</dt>
            <dd class="col-sm-8">@Model.NgayVaoLam.ToString("dd/MM/yyyy")</dd>
        </dl>

        <a asp-action="Edit" class="btn btn-primary">Sửa thông tin</a>
    </div>
</div>
