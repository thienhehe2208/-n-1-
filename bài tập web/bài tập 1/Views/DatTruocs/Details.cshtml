@using bài_tập_1.Models
@model bài_tập_1.Models.DatTruoc

@{
    ViewData["Title"] = "Chi tiết đặt trước";
    var anhMacDinh = "/images/books/banner.jpg";
    var anhBia = string.IsNullOrWhiteSpace(Model.Sach.AnhBia)
        ? anhMacDinh
        : Model.Sach.AnhBia;
    var isStaff = User.IsInRole("Admin") || User.IsInRole("NhanVien");

    var statusClass = Model.TrangThai switch
    {
        TrangThaiDatTruoc.DangCho => "is-waiting",
        TrangThaiDatTruoc.DaCoSach => "is-ready",
        TrangThaiDatTruoc.HoanThanh => "is-completed",
        _ => "is-cancelled"
    };

    var statusText = Model.TrangThai switch
    {
        TrangThaiDatTruoc.DangCho => "Đang chờ xử lý",
        TrangThaiDatTruoc.DaCoSach => "Sách đã sẵn sàng",
        TrangThaiDatTruoc.HoanThanh => "Đã hoàn thành",
        TrangThaiDatTruoc.DaHuy => "Đã hủy",
        TrangThaiDatTruoc.HetHan => "Đã hết hạn",
        _ => Model.TrangThai.ToString()
    };
}

<main class="reservation-result-page">
    <div class="reservation-result-shell">
        @if (TempData["DatTruocSuccess"] is string success)
        {
            <div class="reservation-alert reservation-alert-success">
                <i class="bi bi-check-circle"></i>
                @success
            </div>
        }
        @if (TempData["DatTruocError"] is string error)
        {
            <div class="reservation-alert reservation-alert-danger">@error</div>
        }

        <div class="reservation-result-grid">
            <section class="reservation-card">
                <div class="reservation-result-book">
                    <img src="@anhBia"
                         alt="Ảnh bìa @Model.Sach.TenSach"
                         onerror="this.onerror=null; this.src='@anhMacDinh';" />
                    <div>
                        <span class="reservation-category">
                            @(Model.Sach.TheLoai?.TenTheLoai ?? "Sách")
                        </span>
                        <h2>@Model.Sach.TenSach</h2>
                        <p>@(Model.Sach.NhaXuatBan?.TenNXB ?? "Chưa cập nhật nhà xuất bản")</p>
                        <a asp-controller="Saches"
                               asp-action="Details"
                               asp-route-id="@Model.MaSach">
                            Xem lại chi tiết sách
                        </a>
                    </div>
                </div>
            </section>

            <aside class="reservation-card reservation-request-info">
                <div class="reservation-request-status @statusClass">
                    <span></span>
                    @statusText
                </div>

                <dl>
                    <div>
                        <dt>Độc giả</dt>
                        <dd>@Model.DocGia.HoTen</dd>
                    </div>
                    <div>
                        <dt>Ngày đặt</dt>
                        <dd>@Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</dd>
                    </div>
                    <div>
                        <dt>@(Model.TrangThai == TrangThaiDatTruoc.DaCoSach ? "Nhận sách trước" : "Hàng chờ đến")</dt>
                        <dd>
                            @(Model.TrangThai == TrangThaiDatTruoc.DaCoSach
                                ? Model.HanNhanSach?.ToString("dd/MM/yyyy HH:mm")
                                : Model.NgayHetHanDat?.ToString("dd/MM/yyyy"))
                        </dd>
                    </div>
                    @if (Model.TrangThai == TrangThaiDatTruoc.DangCho)
                    {
                        <div>
                            <dt>Vị trí hàng đợi</dt>
                            <dd>Số @ViewData["ViTriHangDoi"]</dd>
                        </div>
                    }
                    @if (Model.TrangThai == TrangThaiDatTruoc.DaCoSach)
                    {
                        <div>
                            <dt>Bản sao đang giữ</dt>
                            <dd>@Model.BanSaoDuocGiu?.MaVach</dd>
                        </div>
                    }
                    <div>
                        <dt>Điểm nhận</dt>
                        <dd>Quầy lưu thông thư viện</dd>
                    </div>
                </dl>
            </aside>
        </div>

        @if (Model.TrangThai == TrangThaiDatTruoc.DaCoSach)
        {
            <section class="reservation-handoff-panel @(isStaff ? "staff" : "reader")">
                <span><i class="bi @(isStaff ? "bi-journal-plus" : "bi-building-check")"></i></span>
                <div>
                    <small>BƯỚC TIẾP THEO</small>
                    <h2>@(isStaff ? "Xác nhận bàn giao và tạo phiếu mượn" : "Đến quầy để nhận sách")</h2>
                    <p>@(isStaff ? "Chỉ thực hiện khi độc giả đã có mặt và nhận đúng bản sao đang giữ. Hệ thống sẽ chuyển bản sao sang Đang mượn và tạo phiếu mượn tự động." : "Bạn không cần tự chuyển yêu cầu. Hãy mang thẻ độc giả đến quầy trước thời hạn; nhân viên sẽ xác nhận và lập phiếu mượn.")</p>
                </div>
                @if (isStaff)
                {
                    <form asp-action="XacNhanNhanSach" asp-route-id="@Model.MaDatTruoc" method="post" onsubmit="return confirm('Xác nhận độc giả đã nhận sách và tạo phiếu mượn?');">
                        @Html.AntiForgeryToken()
                        <button type="submit"><i class="bi bi-person-check-fill"></i> Xác nhận nhận sách &amp; tạo phiếu mượn</button>
                    </form>
                }
            </section>
        }

        <section class="reservation-card reservation-next-steps">
            <h2>Các bước tiếp theo</h2>
            <div class="reservation-timeline">
                <div class="is-active">
                    <span><i class="bi bi-check-lg"></i></span>
                    <strong>Đã gửi yêu cầu</strong>
                    <small>Thư viện đã tiếp nhận</small>
                </div>
                <div class="@(Model.TrangThai == TrangThaiDatTruoc.DaCoSach || Model.TrangThai == TrangThaiDatTruoc.HoanThanh ? "is-active" : "")">
                    <span><i class="bi bi-bell"></i></span>
                    <strong>Nhận thông báo</strong>
                    <small>Khi sách sẵn sàng</small>
                </div>
                <div class="@(Model.TrangThai == TrangThaiDatTruoc.HoanThanh ? "is-active" : "")">
                    <span><i class="bi bi-building-check"></i></span>
                    <strong>Đến nhận sách</strong>
                    <small>Mang theo thẻ độc giả</small>
                </div>
            </div>
        </section>

        <div class="reservation-result-actions">
            @if (!isStaff)
            {
                <a asp-action="CuaToi" class="btn btn-primary">
                    <i class="bi bi-list-check"></i>
                    Đặt trước của tôi
                </a>
            }
            else
            {
                <a asp-action="Index" class="btn btn-primary">Danh sách yêu cầu</a>
            }

            @if (Model.TrangThai == TrangThaiDatTruoc.DangCho ||
                             Model.TrangThai == TrangThaiDatTruoc.DaCoSach)
            {
                <form asp-action="Huy" asp-route-id="@Model.MaDatTruoc" method="post"
                      onsubmit="return confirm('Bạn chắc chắn muốn hủy yêu cầu này?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-x-circle"></i>
                        Hủy yêu cầu
                    </button>
                </form>
            }

            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                Tiếp tục xem sách
            </a>
        </div>
    </div>
</main>
