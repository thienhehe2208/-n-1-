@using bài_tập_1.Models
@using bài_tập_1.Models.ViewModels
@model IEnumerable<bài_tập_1.Models.DatTruoc>
@{
    ViewData["Title"] = "Trung tâm yêu cầu";
    var onlineRows = ViewData["YeuCauMuonOnline"] as IEnumerable<YeuCauMuonOnline> ?? Enumerable.Empty<YeuCauMuonOnline>();
    var onlineRequests = onlineRows.GroupBy(x => x.MaXacNhan).ToList();
    var onlinePending = ViewData["MuonOnlineChoNhan"] as int? ?? 0;
    var onlineApproved = ViewData["MuonOnlineDaDuyet"] as int? ?? 0;
    var search = ViewData["Search"]?.ToString();
    var status = ViewData["Status"]?.ToString();
}

<section class="request-center-page">
    <header class="request-center-hero">
        <div>
            <span class="request-center-kicker"><i class="bi bi-inboxes"></i> QUẢN LÝ LƯU THÔNG</span>
            <h1>Trung tâm yêu cầu sách</h1>
            <p>Tiếp nhận yêu cầu online, quản lý hàng chờ đặt trước và xác nhận độc giả nhận sách tại một nơi.</p>
        </div>
        <a asp-action="Create"><i class="bi bi-plus-lg"></i> Tạo yêu cầu đặt trước</a>
    </header>

    @if (TempData["DatTruocSuccess"] is string success)
    {
        <div class="request-center-alert success"><i class="bi bi-check-circle-fill"></i><span>@success</span></div>
    }
    @if (TempData["DatTruocError"] is string error)
    {
        <div class="request-center-alert danger"><i class="bi bi-exclamation-circle-fill"></i><span>@error</span></div>
    }
    @if (TempData["Success"] is string loanSuccess)
    {
        <div class="request-center-alert success"><i class="bi bi-check-circle-fill"></i><span>@loanSuccess</span></div>
    }
    @if (TempData["Error"] is string loanError)
    {
        <div class="request-center-alert danger"><i class="bi bi-exclamation-circle-fill"></i><span>@loanError</span></div>
    }

    <div class="request-center-stats">
        <article><span class="blue"><i class="bi bi-journal-check"></i></span><div><small>YÊU CẦU CHỜ DUYỆT</small><strong>@onlinePending</strong><em>Cần kiểm tra các bản sách</em></div></article>
        <article><span class="cyan"><i class="bi bi-person-check"></i></span><div><small>ĐÃ DUYỆT · CHỜ NHẬN</small><strong>@onlineApproved</strong><em>Chờ độc giả đến thư viện</em></div></article>
        <article><span class="amber"><i class="bi bi-hourglass-split"></i></span><div><small>ĐẶT TRƯỚC ĐANG CHỜ</small><strong>@ViewData["DangCho"]</strong><em>Chờ bản sao khả dụng</em></div></article>
        <article><span class="green"><i class="bi bi-bookmark-check"></i></span><div><small>ĐANG GIỮ SÁCH</small><strong>@ViewData["DaCoSach"]</strong><em>Sẵn sàng bàn giao</em></div></article>
    </div>

    <form method="get" class="request-center-toolbar">
        <div class="request-center-search"><i class="bi bi-search"></i><input name="q" value="@search" placeholder="Tìm độc giả, tên sách, mã xác nhận hoặc mã vạch..." /><button type="submit">Tìm kiếm</button></div>
        <select name="trangThai" onchange="this.form.submit()">
            <option value="">Tất cả đặt trước</option>
            <option value="waiting" selected="@(status == "waiting")">Đang chờ</option>
            <option value="ready" selected="@(status == "ready")">Sẵn sàng nhận</option>
            <option value="completed" selected="@(status == "completed")">Hoàn thành</option>
            <option value="cancelled" selected="@(status == "cancelled")">Đã hủy / hết hạn</option>
        </select>
        @if (!string.IsNullOrWhiteSpace(search) || !string.IsNullOrWhiteSpace(status))
        {
            <a asp-action="Index"><i class="bi bi-x-lg"></i> Xóa lọc</a>
        }
    </form>

    <form asp-controller="MuonOnline" asp-action="TraCuu" method="get" class="online-code-lookup">
        <span><i class="bi bi-key"></i></span>
        <div><strong>Độc giả đã đến nhận sách?</strong><small>Nhập mã độc giả cung cấp để mở phiếu đã được duyệt.</small></div>
        <input name="ma" autocomplete="off" placeholder="Ví dụ: A1B2C3D4E5" aria-label="Mã xác nhận" required />
        <button type="submit">Kiểm tra mã</button>
    </form>

    <div class="request-section request-online-section">
        <div class="request-section-heading">
            <div><span>ƯU TIÊN XỬ LÝ</span><h2><i class="bi bi-journal-check"></i> Phiếu mượn do độc giả tạo</h2><p>Duyệt yêu cầu mới trước; chỉ tạo phiếu mượn sau khi độc giả đến quầy và cung cấp mã.</p></div>
            <span class="request-heading-count">@onlineRequests.Count() phiếu hiển thị</span>
        </div>
        @if (!onlineRequests.Any())
        {
            <div class="request-center-empty compact"><span><i class="bi bi-inbox"></i></span><div><h3>Chưa có phiếu mượn online</h3><p>Phiếu do độc giả tạo sẽ tự động xuất hiện tại khu vực này.</p></div></div>
        }
        else
        {
            <div class="online-request-table-wrap">
                <table class="online-request-table">
                    <thead><tr><th>Mã phiếu</th><th>Độc giả</th><th>Sách được giữ</th><th>Lịch nhận / trả</th><th>Trạng thái</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var requestGroup in onlineRequests)
                        {
                            var item = requestGroup.First();
                            var bookCount = requestGroup.Count();
                            var pending = item.TrangThai == TrangThaiYeuCauMuonOnline.ChoNhan;
                            var approved = item.TrangThai == TrangThaiYeuCauMuonOnline.DaDuyet;
                            var expiredSoon = (pending || approved) && item.HanNhanSach <= DateTime.Now.AddHours(12);
                            var stateText = item.TrangThai switch { TrangThaiYeuCauMuonOnline.ChoNhan => "Chờ duyệt", TrangThaiYeuCauMuonOnline.DaDuyet => "Đã duyệt · chờ nhận", TrangThaiYeuCauMuonOnline.DaNhan => "Đã nhận sách", TrangThaiYeuCauMuonOnline.DaHuy => "Đã hủy", TrangThaiYeuCauMuonOnline.TuChoi => "Bị từ chối", _ => "Hết hạn" };
                            var stateClass = item.TrangThai switch { TrangThaiYeuCauMuonOnline.ChoNhan => "pending", TrangThaiYeuCauMuonOnline.DaDuyet => "ready", TrangThaiYeuCauMuonOnline.DaNhan => "received", _ => "closed" };
                            <tr class="@(pending ? "is-pending" : "")">
                                <td><a asp-controller="MuonOnline" asp-action="XacNhan" asp-route-ma="@item.MaXacNhan" class="online-request-code"><i class="bi bi-key"></i><span><strong>#MO-@item.MaXacNhan</strong><small>@item.NgayTao.ToString("HH:mm · dd/MM/yyyy")</small></span></a></td>
                                <td><div class="online-request-reader"><span>@(string.IsNullOrWhiteSpace(item.DocGia.HoTen) ? "DG" : item.DocGia.HoTen.Trim()[0].ToString().ToUpper())</span><div><strong>@item.DocGia.HoTen</strong><small>DG-@item.MaDocGia.ToString("D5")</small></div></div></td>
                                <td><div class="online-request-book"><span><i class="bi bi-bookshelf"></i></span><div><strong>@bookCount cuốn sách</strong><small>@string.Join(" • ", requestGroup.Select(x => x.Sach.TenSach))</small></div></div></td>
                                <td><div class="online-request-dates"><span><i class="bi bi-box-arrow-in-down"></i> Nhận @item.NgayHenNhan.ToString("dd/MM/yyyy")</span><span><i class="bi bi-box-arrow-up"></i> Trả @item.NgayHenTra.ToString("dd/MM/yyyy")</span>@if (expiredSoon){
                                    <em><i class="bi bi-exclamation-triangle"></i> Hiệu lực đến: @item.HanNhanSach.ToString("HH:mm dd/MM")</em>
                                }
                            </div></td>
                            <td><span class="online-request-status @stateClass"><i></i>@stateText</span></td>
                            <td><a asp-controller="MuonOnline" asp-action="XacNhan" asp-route-ma="@item.MaXacNhan" class="online-request-open" title="Mở phiếu"><i class="bi bi-arrow-right"></i></a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="request-section reservation-admin-section">
    <div class="request-section-heading"><div><span>HÀNG ĐỢI ĐẶT TRƯỚC</span><h2><i class="bi bi-bookmarks"></i> Yêu cầu đặt trước</h2><p>Ưu tiên các yêu cầu đã có sách và đang chờ độc giả đến nhận.</p></div><span class="request-heading-count">@ViewData["HoanThanh"] đã hoàn thành</span></div>
    @if (!Model.Any())
    {
        <div class="request-center-empty"><span><i class="bi bi-bookmark"></i></span><div><h3>Không tìm thấy yêu cầu đặt trước</h3><p>Thử thay đổi bộ lọc hoặc tạo yêu cầu mới.</p></div></div>
    }
    else
    {
        <div class="reservation-admin-table-wrap">
            <table class="reservation-admin-table">
                <thead><tr><th>Độc giả</th><th>Sách</th><th>Ngày đặt</th><th>Trạng thái</th><th>Bản sao / thời hạn</th><th>Thao tác</th></tr></thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var statusText = item.TrangThai switch { TrangThaiDatTruoc.DangCho => "Đang chờ", TrangThaiDatTruoc.DaCoSach => "Sẵn sàng nhận", TrangThaiDatTruoc.HoanThanh => "Hoàn thành", TrangThaiDatTruoc.DaHuy => "Đã hủy", _ => "Hết hạn" };
                        var statusClass = item.TrangThai switch { TrangThaiDatTruoc.DangCho => "waiting", TrangThaiDatTruoc.DaCoSach => "ready", TrangThaiDatTruoc.HoanThanh => "completed", _ => "closed" };
                        <tr>
                            <td><div class="reservation-admin-reader"><span>@(string.IsNullOrWhiteSpace(item.DocGia.HoTen) ? "DG" : item.DocGia.HoTen.Trim()[0].ToString().ToUpper())</span><div><strong>@item.DocGia.HoTen</strong><small>DG-@item.MaDocGia.ToString("D5")</small></div></div></td>
                            <td><div class="reservation-admin-book"><i class="bi bi-book"></i><div><strong>@item.Sach.TenSach</strong><small>Yêu cầu #DT-@item.MaDatTruoc.ToString("D5")</small></div></div></td>
                            <td><strong class="reservation-admin-date">@item.NgayDat.ToString("dd/MM/yyyy")</strong><small class="reservation-admin-time">@item.NgayDat.ToString("HH:mm")</small></td>
                            <td><span class="reservation-admin-status @statusClass"><i></i>@statusText</span></td>
                            <td>@if(item.TrangThai==TrangThaiDatTruoc.DaCoSach){
                                <div class="reservation-admin-hold"><strong><i class="bi bi-upc-scan"></i> @item.BanSaoDuocGiu?.MaVach</strong><small>Nhận trước @item.HanNhanSach?.ToString("HH:mm dd/MM/yyyy")</small></div>
                            }else if (item.TrangThai == TrangThaiDatTruoc.DangCho)
                            {

                                <span class="reservation-admin-wait"><i class="bi bi-hourglass"></i> Đến @item.NgayHetHanDat?.ToString("dd/MM/yyyy")</span>
                            }
                            else
                            {

                                <span>—</span>
                            }
                        </td>
                        <td><div class="reservation-admin-actions"><a asp-action="Details" asp-route-id="@item.MaDatTruoc" title="Chi tiết"><i class="bi bi-eye"></i></a>@if(item.TrangThai==TrangThaiDatTruoc.DaCoSach){
                            <form asp-action="XacNhanNhanSach" asp-route-id="@item.MaDatTruoc" method="post" onsubmit="return confirm('Xác nhận độc giả đã nhận bản sao này và tạo phiếu mượn?');">@Html.AntiForgeryToken()<button class="confirm confirm-wide" title="Xác nhận nhận sách và tạo phiếu mượn"><i class="bi bi-person-check"></i><span>Nhận &amp; tạo phiếu</span></button></form>
                        }
                        @if (item.TrangThai is TrangThaiDatTruoc.DangCho or TrangThaiDatTruoc.DaCoSach)
                        {
                            <form asp-action="Huy" asp-route-id="@item.MaDatTruoc" method="post" onsubmit="return confirm('Hủy yêu cầu và chuyển bản sao cho người tiếp theo?');">@Html.AntiForgeryToken()<button class="cancel" title="Hủy"><i class="bi bi-x-lg"></i></button></form>
                        }
                    </div></td>
                </tr>
            }
        </tbody>
    </table>
</div>
        }
        @if (ViewData["Pagination"] is PaginationViewModel pagination)
{
    <div class="request-center-pagination"><partial name="_Pagination" model="pagination" /></div>
}
</div>
</section>
