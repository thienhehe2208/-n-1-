@model bài_tập_1.Models.PhanHoi

@{
    ViewData["Title"] = "Chi tiết phản hồi";
}

<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div><h1 class="h4 mb-1">Phản hồi #@Model.MaPhanHoi</h1><p class="text-muted mb-0">@Model.NgayGui.ToString("dd/MM/yyyy HH:mm")</p></div>
            <span class="badge bg-secondary">@Model.TrangThai</span>
        </div>
        <dl class="row">
            <dt class="col-sm-3">Người gửi</dt><dd class="col-sm-9">@Model.HoTen</dd>
            <dt class="col-sm-3">Email</dt><dd class="col-sm-9"><a href="mailto:@Model.Email">@Model.Email</a></dd>
            <dt class="col-sm-3">Nội dung</dt><dd class="col-sm-9" style="white-space:pre-wrap">@Model.NoiDung</dd>
        </dl>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var nextStatus in new[] { "Mới", "Đang xử lý", "Đã xử lý" })
            {
                <form asp-action="CapNhatTrangThai" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.MaPhanHoi" />
                    <input type="hidden" name="trangThai" value="@nextStatus" />
                    <button class="btn @(Model.TrangThai == nextStatus ? "btn-secondary" : "btn-outline-primary")" disabled="@(Model.TrangThai == nextStatus)" type="submit">@nextStatus</button>
                </form>
            }
            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
        </div>
    </div>
</div>
