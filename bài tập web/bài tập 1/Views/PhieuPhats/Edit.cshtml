@model bài_tập_1.Models.ViewModels.PhieuPhatFormViewModel

@{
    ViewData["Title"] = "Cập nhật phiếu phạt";
}

<div class="card shadow-sm">
    <div class="card-body">
        <h2>
            Cập nhật phiếu #PP@Model.MaPhieuPhat.ToString("D4")
        </h2>

        <partial name="_PhieuPhatFormSummary" model="Model" />

        <form asp-action="Edit"
              asp-route-id="@Model.MaPhieuPhat"
              method="post">
            <input asp-for="MaPhieuPhat" type="hidden" />
            <input asp-for="MaChiTiet" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="LyDo" class="form-label"></label>
                <select asp-for="LyDo"
                        asp-items="ViewBag.LyDo"
                        class="form-select"></select>
                <span asp-validation-for="LyDo"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SoTien" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="SoTien" class="form-control" />
                    <span class="input-group-text">đồng</span>
                </div>
                <span asp-validation-for="SoTien"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Lưu thay đổi
            </button>
            <a asp-action="Details"
               asp-route-id="@Model.MaPhieuPhat"
               class="btn btn-outline-secondary">Hủy</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
