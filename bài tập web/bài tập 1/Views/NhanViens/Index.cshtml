@model IEnumerable<bài_tập_1.Models.NhanVien>

@{
    ViewData["Title"] = "Quản lý nhân viên";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h1 class="h3 mb-1">Quản lý nhân viên</h1><p class="text-muted mb-0">Quản lý tài khoản và hồ sơ nhân viên thư viện.</p></div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus"></i> Thêm nhân viên</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Mã</th><th>Họ tên</th><th>Liên hệ</th><th>Chức vụ</th><th>Ngày vào làm</th><th></th></tr></thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>NV-@item.MaNhanVien.ToString("D5")</td>
                        <td><strong>@item.HoTen</strong></td>
                        <td>@item.Email<br /><small class="text-muted">@item.SoDienThoai</small></td>
                        <td>@item.ChucVu</td>
                        <td>@item.NgayVaoLam.ToString("dd/MM/yyyy")</td>
                        <td class="text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.MaNhanVien" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                            <a asp-action="Edit" asp-route-id="@item.MaNhanVien" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.MaNhanVien" class="btn btn-sm btn-outline-danger">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (ViewData["Pagination"] is PaginationViewModel pagination)
{
    <partial name="_Pagination" model="pagination" />
}
