@model bài_tập_1.Models.ViewModels.CreateNhanVienViewModel

@{
    ViewData["Title"] = "Thêm nhân viên";
}

<section class="staff-create-page">
    <nav class="staff-create-breadcrumb"><a asp-action="Index"><i class="bi bi-arrow-left"></i> Danh sách nhân viên</a><i class="bi bi-chevron-right"></i><span>Thêm nhân viên</span></nav>
    <header class="staff-create-hero"><span><i class="bi bi-person-plus"></i></span><div><small>QUẢN TRỊ NHÂN SỰ</small><h1>Thêm nhân viên mới</h1><p>Tạo đồng thời hồ sơ công tác và tài khoản đăng nhập có quyền Nhân viên.</p></div><strong><i class="bi bi-shield-check"></i> Quyền: Nhân viên</strong></header>

    <form asp-action="Create" method="post" class="staff-create-form">
        <div asp-validation-summary="ModelOnly" class="staff-create-validation"></div>
        <div class="staff-create-layout">
            <main class="staff-create-main">
                <section class="staff-create-card staff-create-section">
                    <div class="staff-create-heading"><span><i class="bi bi-person"></i></span><div><h2>Thông tin cá nhân</h2><p>Thông tin nhận diện và liên hệ của nhân viên.</p></div></div>
                    <div class="staff-create-grid">
                        <div class="staff-create-field wide"><label asp-for="HoTen"><i class="bi bi-person-badge"></i> Họ và tên <em>*</em></label><input asp-for="HoTen" placeholder="Nhập họ tên đầy đủ" /><span asp-validation-for="HoTen"></span></div>
                        <div class="staff-create-field"><label asp-for="NgaySinh"><i class="bi bi-calendar3"></i> Ngày sinh</label><input asp-for="NgaySinh" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" /><span asp-validation-for="NgaySinh"></span></div>
                        <div class="staff-create-field"><label asp-for="GioiTinh"><i class="bi bi-gender-ambiguous"></i> Giới tính</label><select asp-for="GioiTinh"><option value="">-- Chọn giới tính --</option><option value="Nam">Nam</option><option value="Nữ">Nữ</option><option value="Khác">Khác</option></select><span asp-validation-for="GioiTinh"></span></div>
                        <div class="staff-create-field"><label asp-for="SoDienThoai"><i class="bi bi-telephone"></i> Số điện thoại</label><input asp-for="SoDienThoai" type="tel" placeholder="Nhập số điện thoại" /><span asp-validation-for="SoDienThoai"></span></div>
                        <div class="staff-create-field wide"><label asp-for="DiaChi"><i class="bi bi-geo-alt"></i> Địa chỉ</label><input asp-for="DiaChi" placeholder="Nhập địa chỉ liên hệ" /><span asp-validation-for="DiaChi"></span></div>
                    </div>
                </section>
                <section class="staff-create-card staff-create-section">
                    <div class="staff-create-heading"><span><i class="bi bi-briefcase"></i></span><div><h2>Thông tin công tác</h2><p>Vị trí và thời điểm bắt đầu làm việc.</p></div></div>
                    <div class="staff-create-grid"><div class="staff-create-field"><label asp-for="ChucVu"><i class="bi bi-person-workspace"></i> Chức vụ</label><input asp-for="ChucVu" placeholder="Ví dụ: Thủ thư, Nhân viên kho..." /><span asp-validation-for="ChucVu"></span></div><div class="staff-create-field"><label asp-for="NgayVaoLam"><i class="bi bi-calendar-check"></i> Ngày vào làm</label><input asp-for="NgayVaoLam" type="date" /><span asp-validation-for="NgayVaoLam"></span></div></div>
                </section>
                <section class="staff-create-card staff-create-section">
                    <div class="staff-create-heading"><span><i class="bi bi-shield-lock"></i></span><div><h2>Tài khoản đăng nhập</h2><p>Email sẽ được sử dụng làm tên đăng nhập của nhân viên.</p></div></div>
                    <div class="staff-create-notice"><i class="bi bi-info-circle"></i> Tài khoản được xác nhận email tự động và gán quyền <strong>Nhân viên</strong>.</div>
                    <div class="staff-create-grid">
                        <div class="staff-create-field wide"><label asp-for="Email"><i class="bi bi-envelope"></i> Email đăng nhập <em>*</em></label><input asp-for="Email" type="email" autocomplete="email" placeholder="nhanvien@thuvien.vn" /><span asp-validation-for="Email"></span></div>
                        <div class="staff-create-field"><label asp-for="Password"><i class="bi bi-key"></i> Mật khẩu <em>*</em></label><div class="staff-password-field"><input asp-for="Password" autocomplete="new-password" placeholder="Tối thiểu 8 ký tự" /><button type="button" class="staff-password-toggle" aria-label="Hiện mật khẩu" aria-pressed="false"><i class="bi bi-eye"></i></button></div><span asp-validation-for="Password"></span></div>
                        <div class="staff-create-field"><label asp-for="ConfirmPassword"><i class="bi bi-key-fill"></i> Xác nhận mật khẩu <em>*</em></label><div class="staff-password-field"><input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Nhập lại mật khẩu" /><button type="button" class="staff-password-toggle" aria-label="Hiện mật khẩu xác nhận" aria-pressed="false"><i class="bi bi-eye"></i></button></div><span asp-validation-for="ConfirmPassword"></span></div>
                    </div>
                </section>
            </main>
            <aside class="staff-create-sidebar">
                <section class="staff-create-card staff-create-role"><span><i class="bi bi-person-gear"></i></span><h2>Quyền Nhân viên</h2><p>Tài khoản mới có thể thực hiện các nghiệp vụ thư viện được phân quyền.</p><ul><li><i class="bi bi-check2"></i> Quản lý mượn và trả sách</li><li><i class="bi bi-check2"></i> Xử lý đặt trước</li><li><i class="bi bi-check2"></i> Quản lý phiếu phạt</li><li><i class="bi bi-x"></i> Không có quyền quản trị nhân sự</li></ul></section>
                <section class="staff-create-card staff-create-check"><h2><i class="bi bi-clipboard-check"></i> Kiểm tra trước khi tạo</h2><ul><li>Email chưa được sử dụng</li><li>Mật khẩu có ít nhất 8 ký tự</li><li>Thông tin liên hệ chính xác</li><li>Chức vụ phù hợp công việc</li></ul></section>
            </aside>
        </div>
        <footer class="staff-create-actions"><a asp-action="Index"><i class="bi bi-x-lg"></i> Hủy thao tác</a><span><i class="bi bi-shield-lock"></i> Hệ thống sẽ tạo hồ sơ và tài khoản cùng lúc</span><button type="submit"><i class="bi bi-person-check"></i> Tạo nhân viên</button></footer>
    </form>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.querySelectorAll('.staff-password-toggle').forEach(function (button) {
            button.addEventListener('click', function () {
                const input = button.closest('.staff-password-field').querySelector('input');
                const icon = button.querySelector('i');
                const showing = input.type === 'text';
                input.type = showing ? 'password' : 'text';
                icon.className = showing ? 'bi bi-eye' : 'bi bi-eye-slash';
                button.setAttribute('aria-pressed', String(!showing));
                button.setAttribute('aria-label', showing ? 'Hiện mật khẩu' : 'Ẩn mật khẩu');
            });
        });
    </script>
}
